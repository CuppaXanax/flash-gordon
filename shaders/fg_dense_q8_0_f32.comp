#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};
layout(set=0,binding=1)readonly buffer Input{float x[];};
layout(set=0,binding=2)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint n_tok;uint blocks;uint row_bytes;float scale;}pc;
shared float sum[64];

/* Production Q8_0 matvec — block-sequential, 4-quants-per-load.
   Each thread processes complete Q8_0 blocks with stride 64.
   Per block: 1 scale load + 8 groups of 4 quants (8 or 16 uint loads).
   For even blocks (quant byte offset ≡ 2 mod 4): combine 2 words.
   For odd blocks (quant byte offset ≡ 0 mod 4): direct word load.
   Processes 4× more quants per loop iteration than the original kernel. */

void main(){
    uint tid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,tok=gl_WorkGroupID.y;
    if(row>=pc.out_dim||tok>=pc.n_tok)return;
    uint row_byte=row*pc.row_bytes;
    uint x_base=tok*pc.blocks*32u;
    float acc=0.0;

    for(uint block=tid;block<pc.blocks;block+=64u){
        uint bb=row_byte+block*34u; /* byte offset of this Q8_0 block */

        /* Load scale: 2 bytes at bb */
        uint sw=wb[bb>>2u];
        uint sp=(bb&3u)*8u;
        uint sr=(sw>>sp)&0xFFFFu;
        if((bb&3u)==3u){sr=(sw>>24u)|((wb[(bb>>2u)+1u]&0xFFu)<<8u);}
        float d=unpackHalf2x16(sr).x;

        /* Quant start byte and its alignment */
        uint qs=bb+2u;
        uint qw0=qs>>2u;        /* first word containing quant data */
        uint qshift=(qs&3u)*8u; /* 0 or 16 — constant for all 8 groups in this block */
        uint elem=block*32u;

        /* 8 groups of 4 quants each */
        for(uint g=0u;g<8u;g++){
            uint combined;
            if(qshift==0u){
                combined=wb[qw0+g];
            }else{
                combined=(wb[qw0+g]>>qshift)|(wb[qw0+g+1u]<<(32u-qshift));
            }
            int q0=int(combined&0xFFu);q0-=(q0>=128)?256:0;
            int q1=int((combined>>8u)&0xFFu);q1-=(q1>=128)?256:0;
            int q2=int((combined>>16u)&0xFFu);q2-=(q2>=128)?256:0;
            int q3=int(combined>>24u);q3-=(q3>=128)?256:0;
            uint e=x_base+elem+g*4u;
            acc+=d*(float(q0)*x[e]+float(q1)*x[e+1u]+float(q2)*x[e+2u]+float(q3)*x[e+3u]);
        }
    }

    sum[tid]=acc;barrier();
    for(uint s=32u;s>0u;s>>=1u){if(tid<s)sum[tid]+=sum[tid+s];barrier();}
    if(tid==0u)y[tok*pc.out_dim+row]=sum[0]*pc.scale;
}
