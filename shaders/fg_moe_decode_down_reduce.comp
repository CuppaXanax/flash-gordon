#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

/* Batch-1 decode, one dispatch for all routed experts: the down projection
   with the gate-weighted reduction folded in.

   Three on-disk down layouts are handled by one geometry:
     - cooked Q5_1 (down_type 7): 16-row tiles of packed blocks with the
       scales, the fifth-bit plane and the nibble quants in separate runs;
     - cooked Q8_0 (down_type 8, tile_bytes != 0): 16-row tiles with an f16
       scale run and a 32-byte-per-row-block quant run, read with aligned
       uint4 loads;
     - raw row-major Q8_0 (down_type 8, tile_bytes == 0): the 34-byte GGML
       blocks exactly as the packer stores them, read through aligned word
       funnels because the quant payload starts two bytes into each block.

   A workgroup owns 16 output rows and each row is split four ways: lane part
   p = 2*par + h covers the h half (16 values) of blocks par, par+2, ...  For
   the cooked layouts that half is an aligned vector quant load; for the raw
   layout the same half is rebuilt from five aligned words.  Both paths read
   two vector activation words per half and the fifth-bit expansion is a
   single multiply instead of four shift/or pairs; the only barrier is the
   final four-lane row reduction.  The gate is applied once per slot so the
   arithmetic order matches fg_moe_reduce. */

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint wb[]; };
layout(set = 0, binding = 0) readonly buffer WeightsVector { uvec2 wv[]; };
layout(set = 0, binding = 1) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 2) readonly buffer Input { vec4 x4[]; };
layout(set = 0, binding = 3) readonly buffer Gates { float gates[]; };
layout(set = 0, binding = 4) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint tile_bytes;
    uint expert_stride;
    uint slots;
    uint down_type;
} pc;

const uint Q5_1 = 7u;
const uint TILE_WORDS = 9u;
const uint INVALID = 0xffffffffu;
const uint BLOCK_TILE_BYTES = 384u;
const uint ROWS_PER_WORKGROUP = 16u;
const uint PARTS = 4u;

shared float partial[64];

/* Spread four consecutive fifth bits into the high nibble of four bytes so a
   single unpack8 yields four five-bit values. */
uint spread4(uint bits) {
    return ((bits * 0x00204081u) & 0x01010101u) << 4u;
}

void main() {
    uint local_id = gl_LocalInvocationID.x;
    if (pc.down_type == 8u && pc.tile_bytes != 0u) {
        /* Cooked Q8_0 down tiles: eight lanes own one output row and each lane
           reads one aligned four-value word of every 32-value block, so a warp
           touches one fully used 32-byte sector per row-block instead of the
           scattered half-sectors the old row-major geometry produced. */
        uint lane8 = local_id & 7u;
        uint row8 = gl_WorkGroupID.x * 8u + (local_id >> 3u);
        bool live8 = row8 < pc.out_dim;
        uint row_tile8 = row8 >> 4u;
        uint tile_row8 = row8 & 15u;
        uint quant_offset8 = (pc.blocks * 32u + 63u) & ~63u;
        float accumulator8 = 0.0;
        if (live8) {
            for (uint slot = 0u; slot < pc.slots; slot++) {
                uint tile_base = slot * TILE_WORDS;
                uint expert = tiles[tile_base];
                if (expert == INVALID) continue;
                uint pair = tiles[tile_base + 1u];
                if (pair == INVALID) continue;
                float gate = gates[slot];
                uint row_base = expert * pc.expert_stride + row_tile8 * pc.tile_bytes;
                uint input_base = pair * (pc.in_dim >> 2u);
                float slot_acc = 0.0;
                for (uint block = 0u; block < pc.blocks; block++) {
                    uint scale_byte = row_base + (block * 16u + tile_row8) * 2u;
                    vec2 scale = unpackHalf2x16(wb[scale_byte >> 2u]);
                    float delta = (scale_byte & 2u) == 0u ? scale.x : scale.y;
                    uint quant_byte = row_base + quant_offset8 +
                        (tile_row8 * pc.blocks + block) * 32u + lane8 * 4u;
                    uint packed = wb[quant_byte >> 2u];
                    vec4 weight = vec4(unpack8(int(packed))) * delta;
                    vec4 input_value = x4[input_base + block * 8u + lane8];
                    slot_acc += dot(weight, input_value);
                }
                accumulator8 = fma(gate, slot_acc, accumulator8);
            }
        }
        partial[local_id] = accumulator8;
        barrier();
        if (live8 && lane8 == 0u) {
            uint offset = (local_id >> 3u) * 8u;
            y[row8] = ((partial[offset] + partial[offset + 4u]) +
                       (partial[offset + 2u] + partial[offset + 6u])) +
                      ((partial[offset + 1u] + partial[offset + 5u]) +
                       (partial[offset + 3u] + partial[offset + 7u]));
        }
        return;
    }
    uint part = local_id & (PARTS - 1u);
    uint row_slot = local_id >> 2u;
    uint row = gl_WorkGroupID.x * ROWS_PER_WORKGROUP + row_slot;
    bool row_live = row < pc.out_dim;
    uint seg = part & 1u;
    uint parity = part >> 1u;

    float accumulator = 0.0;
    for (uint slot = 0u; slot < pc.slots; slot++) {
        uint tile_base = slot * TILE_WORDS;
        uint expert = tiles[tile_base];
        if (expert == INVALID) continue;
        uint pair = tiles[tile_base + 1u];
        if (pair == INVALID) continue;
        if (!row_live) continue;

        float gate = gates[slot];
        float slot_acc = 0.0;
        if (pc.down_type == Q5_1) {
            uint row_tile = row >> 4u;
            uint tile_row = row & 15u;
            uint row_base = expert * pc.expert_stride + row_tile * pc.tile_bytes;
            uint input_base = pair * (pc.in_dim >> 2u);
            for (uint block = parity; block < pc.blocks; block += 2u) {
                uint block_base = row_base + block * BLOCK_TILE_BYTES;
                vec2 scale_min = unpackHalf2x16(wb[(block_base + tile_row * 4u) >> 2u]);
                uint high_word = wb[(block_base + 64u + tile_row * 4u) >> 2u];
                uvec2 quant = wv[((block_base + 128u + tile_row * 16u) >> 3u) + seg];
                for (uint word = 0u; word < 2u; word++) {
                    uint packed = quant[word];
                    uint low = packed & 0x0f0f0f0fu;
                    uint high = (packed >> 4u) & 0x0f0f0f0fu;
                    uint bit_base = seg * 8u + word * 4u;
                    uint low_bits = (high_word >> bit_base) & 15u;
                    uint high_bits = (high_word >> (16u + bit_base)) & 15u;
                    vec4 weight_lo = fma(vec4(scale_min.x),
                        vec4(unpack8(int(low | spread4(low_bits)))),
                        vec4(scale_min.y));
                    vec4 weight_hi = fma(vec4(scale_min.x),
                        vec4(unpack8(int(high | spread4(high_bits)))),
                        vec4(scale_min.y));
                    vec4 input_lo = x4[input_base + block * 8u + seg * 2u + word];
                    vec4 input_hi = x4[input_base + block * 8u + seg * 2u + 4u + word];
                    slot_acc += dot(weight_lo, input_lo) + dot(weight_hi, input_hi);
                }
            }
        } else if (pc.down_type == 8u && pc.tile_bytes != 0u) {
            uint row_tile = row >> 4u;
            uint tile_row = row & 15u;
            uint row_base = expert * pc.expert_stride + row_tile * pc.tile_bytes;
            uint input_base = pair * (pc.in_dim >> 2u);
            uint quant_offset = (pc.blocks * 32u + 63u) & ~63u;
            for (uint block = parity; block < pc.blocks; block += 2u) {
                uint scale_byte = row_base + (block * 16u + tile_row) * 2u;
                vec2 scale = unpackHalf2x16(wb[scale_byte >> 2u]);
                float delta = (scale_byte & 2u) == 0u ? scale.x : scale.y;
                uint quant_base = row_base + quant_offset +
                    (tile_row * pc.blocks + block) * 32u + seg * 16u;
                vec4 w0 = vec4(unpack8(int(wb[quant_base >> 2u]))) * delta;
                vec4 w1 = vec4(unpack8(int(wb[(quant_base >> 2u) + 1u]))) * delta;
                vec4 w2 = vec4(unpack8(int(wb[(quant_base >> 2u) + 2u]))) * delta;
                vec4 w3 = vec4(unpack8(int(wb[(quant_base >> 2u) + 3u]))) * delta;
                vec4 input0 = x4[input_base + block * 8u + seg * 4u];
                vec4 input1 = x4[input_base + block * 8u + seg * 4u + 1u];
                vec4 input2 = x4[input_base + block * 8u + seg * 4u + 2u];
                vec4 input3 = x4[input_base + block * 8u + seg * 4u + 3u];
                slot_acc += dot(w0, input0) + dot(w1, input1) +
                    dot(w2, input2) + dot(w3, input3);
            }
        } else {
            uint row_bytes = pc.blocks * 34u;
            uint row_base = expert * pc.expert_stride + row * row_bytes;
            uint input_base = pair * (pc.in_dim >> 2u);
            for (uint block = parity; block < pc.blocks; block += 2u) {
                uint base = row_base + block * 34u;
                uint scale_word = wb[base >> 2u];
                uint scale_shift = (base & 3u) * 8u;
                uint scale_bits = (scale_word >> scale_shift) & 65535u;
                if (scale_shift == 24u)
                    scale_bits = (scale_word >> 24u) |
                        ((wb[(base >> 2u) + 1u] & 255u) << 8u);
                float delta = unpackHalf2x16(scale_bits).x;
                uint quant_start = base + 2u + seg * 16u;
                vec4 weight[4];
                for (uint word = 0u; word < 4u; word++) {
                    uint offset = quant_start + word * 4u;
                    uint shift = (offset & 3u) * 8u;
                    uint packed = shift == 0u ? wb[offset >> 2u] :
                        (wb[offset >> 2u] >> shift) |
                        (wb[(offset >> 2u) + 1u] << (32u - shift));
                    weight[word] = vec4(unpack8(int(packed))) * delta;
                }
                vec4 input0 = x4[input_base + block * 8u + seg * 4u];
                vec4 input1 = x4[input_base + block * 8u + seg * 4u + 1u];
                vec4 input2 = x4[input_base + block * 8u + seg * 4u + 2u];
                vec4 input3 = x4[input_base + block * 8u + seg * 4u + 3u];
                slot_acc += dot(weight[0], input0) + dot(weight[1], input1) +
                    dot(weight[2], input2) + dot(weight[3], input3);
            }
        }
        accumulator = fma(gate, slot_acc, accumulator);
    }

    partial[local_id] = accumulator;
    barrier();
    if (row_live && part == 0u) {
        uint offset = row_slot * PARTS;
        y[row] = (partial[offset] + partial[offset + 1u]) +
            (partial[offset + 2u] + partial[offset + 3u]);
    }
}
