#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

/* Batch-1 decode, one dispatch for all routed experts: the down projection
   with the gate-weighted reduction folded in.

   Three on-disk down layouts are handled by one geometry:
     - cooked Q5_1 (down_type 7): 16-row tiles of packed blocks with the
       scales, the fifth-bit plane and the nibble quants in separate runs;
     - cooked Q8_0 (down_type 8, tile_bytes != 0): 16-row tiles with an f16
       scale run and a 32-byte-per-row-block quant run, read with aligned
       uvec2 loads;
     - raw row-major Q8_0 (down_type 8, tile_bytes == 0): the 34-byte GGML
       blocks exactly as the packer stores them, read through aligned word
       funnels because the quant payload starts two bytes into each block.

   Thirty-two lanes and two adjacent rows per lane: a lane carries the same
   four-way (parity, half) split of one row as before for both rows of its
   pair, so the per-lane block order, the per-slot fma chain and the final
   four-way row reduction are unchanged and every output bit is identical.
   The pair shares one scale/fifth-bit word pair and one activation read per
   block, which halves the activation traffic per weight byte, and the cooked
   Q5_1 weights are read as aligned uvec2 words.  The Q5_1 block loop batches
   four owned blocks per iteration (a 4x2-block stride walk) so a wave keeps
   four weight streams in flight; the block accumulation order is untouched,
   so the batch is bit-identical to the unbatched walk.  The cooked Q8_0 path
   gives each lane two four-value words of a row block (one uvec2) and two
   accumulators, so its quant and scale loads per value halve as well.

   A workgroup still owns 16 output rows and the same dispatch grid. */

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint wb[]; };
layout(set = 0, binding = 0) readonly buffer WeightsVector { uvec2 wv[]; };
layout(set = 0, binding = 1) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 2) readonly buffer Input { vec4 x4[]; };
layout(set = 0, binding = 3) readonly buffer Gates { float gates[]; };
layout(set = 0, binding = 4) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint tile_bytes;
    uint expert_stride;
    uint slots;
    uint down_type;
    uint token_count;
} pc;

const uint Q5_1 = 7u;
const uint TILE_WORDS = 9u;
const uint INVALID = 0xffffffffu;
const uint ROWS_PER_WORKGROUP = 16u;
const uint PARTS = 4u;

/* Two tokens' partials: 8 rows x 8 lanes (cooked Q8 path) or 16 row-pairs x 4
   parts (generic path), each within one token's slot of the array. */
shared float partial[128];

/* One owned 32-value block of a row pair.  The pair's scale/min and fifth-bit
   words are adjacent u32s, so one uvec2 each feeds both rows; the four
   activation vec4 loads are shared, and the two rows' quant uvec2s sit two
   apart.  SM_OFF/Q_OFF are uvec2 strides of the owned-block walk, IN_OFF is
   the vec4 stride.  The two rows' accumulation expressions are exactly the
   single-row ones, in the same order, so the output bits are unchanged. */
#define FG_DOWN_PAIR(SM_OFF, Q_OFF, IN_OFF) { \
                uvec2 sm = wv[sm_uvec + (SM_OFF)]; \
                uvec2 hw = wv[hw_uvec + (SM_OFF)]; \
                uvec2 q0 = wv[qt_uvec + (Q_OFF)]; \
                uvec2 q1 = wv[qt_uvec + (Q_OFF) + 2u]; \
                vec2 sm0 = unpackHalf2x16(sm.x); \
                vec2 sm1 = unpackHalf2x16(sm.y); \
                uint hw0 = hw.x; \
                uint hw1 = hw.y; \
                vec4 i0 = x4[in_vec + (IN_OFF)]; \
                vec4 i4 = x4[in_vec + (IN_OFF) + 4u]; \
                vec4 i1 = x4[in_vec + (IN_OFF) + 1u]; \
                vec4 i5 = x4[in_vec + (IN_OFF) + 5u]; \
                uint lo0 = q0.x & 0x0f0f0f0fu; \
                uint hi0 = (q0.x >> 4u) & 0x0f0f0f0fu; \
                uint lo1 = q0.y & 0x0f0f0f0fu; \
                uint hi1 = (q0.y >> 4u) & 0x0f0f0f0fu; \
                vec4 w0 = fma(vec4(sm0.x), vec4(unpack8(int(lo0 | spread4((hw0 >> bit_base) & 15u)))), vec4(sm0.y)); \
                vec4 w1 = fma(vec4(sm0.x), vec4(unpack8(int(hi0 | spread4((hw0 >> (16u + bit_base)) & 15u)))), vec4(sm0.y)); \
                vec4 w2 = fma(vec4(sm0.x), vec4(unpack8(int(lo1 | spread4((hw0 >> (bit_base + 4u)) & 15u)))), vec4(sm0.y)); \
                vec4 w3 = fma(vec4(sm0.x), vec4(unpack8(int(hi1 | spread4((hw0 >> (20u + bit_base)) & 15u)))), vec4(sm0.y)); \
                uint pl0 = q1.x & 0x0f0f0f0fu; \
                uint ph0 = (q1.x >> 4u) & 0x0f0f0f0fu; \
                uint pl1 = q1.y & 0x0f0f0f0fu; \
                uint ph1 = (q1.y >> 4u) & 0x0f0f0f0fu; \
                vec4 p0 = fma(vec4(sm1.x), vec4(unpack8(int(pl0 | spread4((hw1 >> bit_base) & 15u)))), vec4(sm1.y)); \
                vec4 p1 = fma(vec4(sm1.x), vec4(unpack8(int(ph0 | spread4((hw1 >> (16u + bit_base)) & 15u)))), vec4(sm1.y)); \
                vec4 p2 = fma(vec4(sm1.x), vec4(unpack8(int(pl1 | spread4((hw1 >> (bit_base + 4u)) & 15u)))), vec4(sm1.y)); \
                vec4 p3 = fma(vec4(sm1.x), vec4(unpack8(int(ph1 | spread4((hw1 >> (20u + bit_base)) & 15u)))), vec4(sm1.y)); \
                slot_acc += dot(w0, i0) + dot(w1, i4); \
                slot_acc += dot(w2, i1) + dot(w3, i5); \
                slot_acc_pair += dot(p0, i0) + dot(p1, i4); \
                slot_acc_pair += dot(p2, i1) + dot(p3, i5); }

/* Spread four consecutive fifth bits into the high nibble of four bytes so a
   single unpack8 yields four five-bit values. */
uint spread4(uint bits) {
    return ((bits * 0x00204081u) & 0x01010101u) << 4u;
}

float dot4f(uint weight_word, vec4 activation) {
    return dot(vec4(unpack8(int(weight_word))), activation);
}

void main() {
    uint local_id = gl_LocalInvocationID.x;
    if (pc.down_type == 8u && pc.tile_bytes != 0u) {
        /* Cooked Q8_0 down tiles: four lanes own one output row and each lane
           reads one aligned eight-value word pair of every 32-value block into
           two accumulators, so a warp touches one fully used 32-byte sector
           per row-block while the scale word stays shared four ways. */
        uint lane4 = local_id & 3u;
        uint row8 = gl_WorkGroupID.x * 8u + (local_id >> 2u);
        bool live8 = row8 < pc.out_dim;
        uint row_tile8 = row8 >> 4u;
        uint tile_row8 = row8 & 15u;
        uint quant_offset8 = (pc.blocks * 32u + 63u) & ~63u;
        for (uint token = 0u; token < pc.token_count; token++) {
            float accumulator_lo = 0.0;
            float accumulator_hi = 0.0;
            if (live8) {
                for (uint slot = 0u; slot < pc.slots; slot++) {
                    uint tile_base = slot * TILE_WORDS;
                    uint expert = tiles[tile_base];
                    if (expert == INVALID) continue;
                    uint tile_token = tiles[tile_base + 2u];
                    if (tile_token != INVALID && tile_token != token) continue;
                    uint pair = tiles[tile_base + 1u];
                    if (pair == INVALID) continue;
                    float gate = gates[slot];
                    uint row_base = expert * pc.expert_stride + row_tile8 * pc.tile_bytes;
                    uint input_base = pair * (pc.in_dim >> 2u);
                    uint scale_word = (row_base + tile_row8 * 2u) >> 2u;
                    uint quant_word = (row_base + quant_offset8 + tile_row8 * pc.blocks * 32u + lane4 * 8u) >> 2u;
                    uint in_vec = input_base + lane4 * 2u;
                    bool upper = (tile_row8 & 1u) != 0u;
                    float slot_lo = 0.0;
                    float slot_hi = 0.0;
                    for (uint block = 0u; block < pc.blocks; block++) {
                        vec2 scale = unpackHalf2x16(wb[scale_word]);
                        uvec2 packed = wv[quant_word >> 1u];
                        float delta = upper ? scale.y : scale.x;
                        slot_lo = fma(delta, dot4f(packed.x, x4[in_vec]), slot_lo);
                        slot_hi = fma(delta, dot4f(packed.y, x4[in_vec + 1u]), slot_hi);
                        scale_word += 8u;
                        quant_word += 8u;
                        in_vec += 8u;
                    }
                    accumulator_lo = fma(gate, slot_lo, accumulator_lo);
                    accumulator_hi = fma(gate, slot_hi, accumulator_hi);
                }
            }
            uint row_offset = (token * 8u + (local_id >> 2u)) * 8u;
            partial[row_offset + lane4 * 2u] = accumulator_lo;
            partial[row_offset + lane4 * 2u + 1u] = accumulator_hi;
            barrier();
            if (live8 && lane4 == 0u) {
                y[token * pc.out_dim + row8] =
                    ((partial[row_offset] + partial[row_offset + 4u]) +
                     (partial[row_offset + 2u] + partial[row_offset + 6u])) +
                    ((partial[row_offset + 1u] + partial[row_offset + 5u]) +
                     (partial[row_offset + 3u] + partial[row_offset + 7u]));
            }
            barrier();
        }
        return;
    }
    uint part = local_id & (PARTS - 1u);
    uint pair_slot = local_id >> 2u;
    uint row = gl_WorkGroupID.x * ROWS_PER_WORKGROUP + pair_slot * 2u;
    bool row_live = row < pc.out_dim;
    uint seg = part & 1u;
    uint parity = part >> 1u;

    for (uint token = 0u; token < pc.token_count; token++) {
    float accumulator = 0.0;
    float accumulator_pair = 0.0;
    for (uint slot = 0u; slot < pc.slots; slot++) {
        uint tile_base = slot * TILE_WORDS;
        uint expert = tiles[tile_base];
        if (expert == INVALID) continue;
        uint tile_token = tiles[tile_base + 2u];
        if (tile_token != INVALID && tile_token != token) continue;
        uint pair = tiles[tile_base + 1u];
        if (pair == INVALID) continue;
        if (!row_live) continue;

        float gate = gates[slot];
        float slot_acc = 0.0;
        float slot_acc_pair = 0.0;
        if (pc.down_type == Q5_1) {
            uint row_tile = row >> 4u;
            uint tile_row = row & 15u;
            uint row_base = expert * pc.expert_stride + row_tile * pc.tile_bytes;
            uint input_base = pair * (pc.in_dim >> 2u);
            uint sm_uvec = ((row_base + tile_row * 4u) >> 3u) + parity * 48u;
            uint hw_uvec = sm_uvec + 8u;
            uint qt_uvec = ((row_base + 128u + tile_row * 16u) >> 3u) + parity * 48u + seg;
            uint in_vec = input_base + parity * 8u + seg * 2u;
            uint bit_base = seg * 8u;
            uint block = parity;
            for (; block + 6u < pc.blocks; block += 8u) {
                FG_DOWN_PAIR(0u, 0u, 0u)
                FG_DOWN_PAIR(96u, 96u, 16u)
                FG_DOWN_PAIR(192u, 192u, 32u)
                FG_DOWN_PAIR(288u, 288u, 48u)
                sm_uvec += 384u;
                hw_uvec += 384u;
                qt_uvec += 384u;
                in_vec += 64u;
            }
            for (; block + 2u < pc.blocks; block += 4u) {
                FG_DOWN_PAIR(0u, 0u, 0u)
                FG_DOWN_PAIR(96u, 96u, 16u)
                sm_uvec += 192u;
                hw_uvec += 192u;
                qt_uvec += 192u;
                in_vec += 32u;
            }
            if (block < pc.blocks) {
                FG_DOWN_PAIR(0u, 0u, 0u)
            }
        } else {
            uint row_bytes = pc.blocks * 34u;
            uint row_base = expert * pc.expert_stride + row * row_bytes;
            uint row_base_pair = row_base + row_bytes;
            uint input_base = pair * (pc.in_dim >> 2u);
            for (uint block = parity; block < pc.blocks; block += 2u) {
                uint base = row_base + block * 34u;
                uint scale_word = wb[base >> 2u];
                uint scale_shift = (base & 3u) * 8u;
                uint scale_bits = (scale_word >> scale_shift) & 65535u;
                if (scale_shift == 24u)
                    scale_bits = (scale_word >> 24u) |
                        ((wb[(base >> 2u) + 1u] & 255u) << 8u);
                float delta = unpackHalf2x16(scale_bits).x;
                uint quant_start = base + 2u + seg * 16u;
                vec4 weight[4];
                for (uint word = 0u; word < 4u; word++) {
                    uint offset = quant_start + word * 4u;
                    uint shift = (offset & 3u) * 8u;
                    uint packed = shift == 0u ? wb[offset >> 2u] :
                        (wb[offset >> 2u] >> shift) |
                        (wb[(offset >> 2u) + 1u] << (32u - shift));
                    weight[word] = vec4(unpack8(int(packed))) * delta;
                }
                uint base_pair = row_base_pair + block * 34u;
                uint scale_word_pair = wb[base_pair >> 2u];
                uint scale_shift_pair = (base_pair & 3u) * 8u;
                uint scale_bits_pair = (scale_word_pair >> scale_shift_pair) & 65535u;
                if (scale_shift_pair == 24u)
                    scale_bits_pair = (scale_word_pair >> 24u) |
                        ((wb[(base_pair >> 2u) + 1u] & 255u) << 8u);
                float delta_pair = unpackHalf2x16(scale_bits_pair).x;
                uint quant_start_pair = base_pair + 2u + seg * 16u;
                vec4 weight_pair[4];
                for (uint word = 0u; word < 4u; word++) {
                    uint offset = quant_start_pair + word * 4u;
                    uint shift = (offset & 3u) * 8u;
                    uint packed = shift == 0u ? wb[offset >> 2u] :
                        (wb[offset >> 2u] >> shift) |
                        (wb[(offset >> 2u) + 1u] << (32u - shift));
                    weight_pair[word] = vec4(unpack8(int(packed))) * delta_pair;
                }
                vec4 input0 = x4[input_base + block * 8u + seg * 4u];
                vec4 input1 = x4[input_base + block * 8u + seg * 4u + 1u];
                vec4 input2 = x4[input_base + block * 8u + seg * 4u + 2u];
                vec4 input3 = x4[input_base + block * 8u + seg * 4u + 3u];
                slot_acc += dot(weight[0], input0) + dot(weight[1], input1) +
                    dot(weight[2], input2) + dot(weight[3], input3);
                slot_acc_pair += dot(weight_pair[0], input0) + dot(weight_pair[1], input1) +
                    dot(weight_pair[2], input2) + dot(weight_pair[3], input3);
            }
        }
        accumulator = fma(gate, slot_acc, accumulator);
        accumulator_pair = fma(gate, slot_acc_pair, accumulator_pair);
    }

    uint row_offset = (token * ROWS_PER_WORKGROUP + pair_slot * 2u) * PARTS;
    partial[row_offset + part] = accumulator;
    partial[row_offset + PARTS + part] = accumulator_pair;
    barrier();
    if (row_live && part == 0u) {
        y[token * pc.out_dim + row] = (partial[row_offset] + partial[row_offset + 1u]) +
            (partial[row_offset + 2u] + partial[row_offset + 3u]);
        uint pair_row = row + 1u;
        if (pair_row < pc.out_dim) {
            uint pair_offset = row_offset + PARTS;
            y[token * pc.out_dim + pair_row] = (partial[pair_offset] + partial[pair_offset + 1u]) +
                (partial[pair_offset + 2u] + partial[pair_offset + 3u]);
        }
    }
    barrier();
    }
}
