#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer RawQueryGate{float raw_qg[];};layout(set=0,binding=1)readonly buffer RawKey{float raw_k[];};layout(set=0,binding=2)readonly buffer QueryNorm{float qnorm[];};layout(set=0,binding=3)readonly buffer KeyNorm{float knorm[];};layout(set=0,binding=4)readonly buffer Position{uint position[];};layout(set=0,binding=5)writeonly buffer Query{float query[];};layout(set=0,binding=6)writeonly buffer Gate{float gate[];};layout(set=0,binding=7)writeonly buffer Key{float key[];};
shared float values[256];shared float squares[256];
void normalize_rope(uint lane,float weight){float value=values[lane];squares[lane]=value*value;barrier();for(uint stride=128u;stride>0u;stride>>=1u){if(lane<stride)squares[lane]+=squares[lane+stride];barrier();}values[lane]=value*inversesqrt(squares[0]/256.0+1e-6)*weight;barrier();if(lane<32u){uint axis=(lane%3u==1u)?1u:((lane%3u==2u&&lane<30u)?2u:0u);float angle=float(position[axis])/pow(10000000.0,float(2u*lane)/64.0),c=cos(angle),s=sin(angle),a=values[lane],b=values[lane+32u];values[lane]=a*c-b*s;values[lane+32u]=b*c+a*s;}barrier();}
void main(){uint lane=gl_LocalInvocationID.x,head=gl_WorkGroupID.x;if(head>=24u)return;values[lane]=raw_qg[head*512u+lane];gate[head*256u+lane]=raw_qg[head*512u+256u+lane];normalize_rope(lane,qnorm[lane]);query[head*256u+lane]=values[lane];barrier();if(head<2u){values[lane]=raw_k[head*256u+lane];normalize_rope(lane,knorm[lane]);key[head*256u+lane]=values[lane];}}
