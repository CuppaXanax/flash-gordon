#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Input{float x[];};layout(set=0,binding=1)readonly buffer Weight{float w[];};layout(set=0,binding=2)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint width;uint groups;uint n_tok;float eps;}pc;shared float sums[256];
void main(){uint tid=gl_LocalInvocationID.x,g=gl_WorkGroupID.x,t=gl_WorkGroupID.y;if(g>=pc.groups||t>=pc.n_tok)return;uint base=(t*pc.groups+g)*pc.width;float ss=0.0;for(uint i=tid;i<pc.width;i+=256u)ss=fma(x[base+i],x[base+i],ss);sums[tid]=ss;barrier();for(uint stride=128u;stride>0u;stride>>=1u){if(tid<stride)sums[tid]+=sums[tid+stride];barrier();}float scale=inversesqrt(sums[0]/float(pc.width)+pc.eps);for(uint i=tid;i<pc.width;i+=256u)y[base+i]=x[base+i]*scale*w[g*pc.width+i];}
