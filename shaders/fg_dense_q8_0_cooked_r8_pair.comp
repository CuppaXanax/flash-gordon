#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x=128,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};
layout(set=0,binding=0)readonly buffer WeightsPair{uvec2 wb2[];};
layout(set=0,binding=0)readonly buffer WeightsVector{uvec4 wb4[];};
layout(set=0,binding=1)readonly buffer Input{vec4 x4[];};
layout(set=0,binding=2)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint n_tok;uint blocks;uint tile_bytes;float scale;}pc;
shared vec4 subgroup_sum[256];

void main(){
    uint local_id=gl_LocalInvocationID.x;
    uint block_in_group=local_id&31u,word_pair=local_id>>5u;
    uint first_row=gl_WorkGroupID.x*8u,token=gl_WorkGroupID.y;
    if(first_row>=pc.out_dim||token>=pc.n_tok)return;
    uint tile_base=(first_row>>4u)*pc.tile_bytes,tile_row=first_row&15u;
    uint quant_offset=(16u*pc.blocks*2u+63u)&~63u;
    uvec4 rows=uvec4(tile_row,tile_row+1u,tile_row+2u,tile_row+3u),rows1=rows+4u;
    uvec4 quant_base0=tile_base+quant_offset+rows*pc.blocks*32u,quant_base1=tile_base+quant_offset+rows1*pc.blocks*32u;
    uint input_base=token*pc.blocks*8u,groups=(pc.blocks+31u)/32u;
    vec4 accumulator0=vec4(0.0),accumulator1=vec4(0.0);
    for(uint group=0u;group<groups;group++){
        uint block=group*32u+block_in_group;bool live=block<pc.blocks;
        uint safe_block=live?block:(pc.blocks-1u);
        uint scale_word=(tile_base>>2u)+safe_block*8u+(tile_row>>1u);
        uvec4 scales=wb4[scale_word>>2u];
        vec4 delta0=live?vec4(unpackHalf2x16(scales.x),unpackHalf2x16(scales.y)):vec4(0.0);
        vec4 delta1=live?vec4(unpackHalf2x16(scales.z),unpackHalf2x16(scales.w)):vec4(0.0);
        uint pair_base=safe_block*4u+word_pair;
        uvec2 packed00=wb2[(quant_base0.x>>3u)+pair_base],packed01=wb2[(quant_base1.x>>3u)+pair_base];
        uvec2 packed10=wb2[(quant_base0.y>>3u)+pair_base],packed11=wb2[(quant_base1.y>>3u)+pair_base];
        uvec2 packed20=wb2[(quant_base0.z>>3u)+pair_base],packed21=wb2[(quant_base1.z>>3u)+pair_base];
        uvec2 packed30=wb2[(quant_base0.w>>3u)+pair_base],packed31=wb2[(quant_base1.w>>3u)+pair_base];
        uint input_index=input_base+safe_block*8u+word_pair*2u;
        vec4 input_lo=live?x4[input_index]:vec4(0.0);
        vec4 input_hi=live?x4[input_index+1u]:vec4(0.0);
        vec4 products0=vec4(dot(vec4(unpack8(int32_t(packed00.x))),input_lo)+dot(vec4(unpack8(int32_t(packed00.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed10.x))),input_lo)+dot(vec4(unpack8(int32_t(packed10.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed20.x))),input_lo)+dot(vec4(unpack8(int32_t(packed20.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed30.x))),input_lo)+dot(vec4(unpack8(int32_t(packed30.y))),input_hi));
        vec4 products1=vec4(dot(vec4(unpack8(int32_t(packed01.x))),input_lo)+dot(vec4(unpack8(int32_t(packed01.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed11.x))),input_lo)+dot(vec4(unpack8(int32_t(packed11.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed21.x))),input_lo)+dot(vec4(unpack8(int32_t(packed21.y))),input_hi),
                            dot(vec4(unpack8(int32_t(packed31.x))),input_lo)+dot(vec4(unpack8(int32_t(packed31.y))),input_hi));
        accumulator0=fma(delta0,products0,accumulator0);
        accumulator1=fma(delta1,products1,accumulator1);
    }
    vec4 reduced0=vec4(subgroupAdd(accumulator0.x),subgroupAdd(accumulator0.y),subgroupAdd(accumulator0.z),subgroupAdd(accumulator0.w));
    vec4 reduced1=vec4(subgroupAdd(accumulator1.x),subgroupAdd(accumulator1.y),subgroupAdd(accumulator1.z),subgroupAdd(accumulator1.w));
    if(subgroupElect()){subgroup_sum[gl_SubgroupID]=reduced0;subgroup_sum[128u+gl_SubgroupID]=reduced1;}
    barrier();
    if(local_id==0u){
        vec4 total0=vec4(0.0),total1=vec4(0.0);
        for(uint subgroup=0u;subgroup<gl_NumSubgroups;subgroup++){total0+=subgroup_sum[subgroup];total1+=subgroup_sum[128u+subgroup];}
        for(uint row=0u;row<4u;row++){
            if(first_row+row<pc.out_dim)y[token*pc.out_dim+first_row+row]=total0[row]*pc.scale;
            if(first_row+4u+row<pc.out_dim)y[token*pc.out_dim+first_row+4u+row]=total1[row]*pc.scale;
        }
    }
}
