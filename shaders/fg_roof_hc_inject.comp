#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_shuffle_relative : require
layout(local_size_x=256)in;
layout(set=0,binding=0)readonly buffer Normalized{float normalized[];};
layout(set=0,binding=1)readonly buffer Weights{float weights[];};
layout(set=0,binding=2)writeonly buffer Partials{float partials[];};
layout(push_constant)uniform Push{uint hidden;uint groups;uint tokens;uint pieces;}pc;
shared vec4 sums[256];
void main(){
    uint lane=gl_LocalInvocationID.x,piece=gl_WorkGroupID.x,token=gl_WorkGroupID.y;
    uint width=pc.hidden*pc.groups,first=piece*256u+lane,stride=pc.pieces*256u;
    vec4 acc=vec4(0.0);
    for(uint index=first;index<width;index+=stride){
        float x=normalized[token*width+index];
        acc=fma(vec4(weights[index],weights[width+index],
            weights[2u*width+index],weights[3u*width+index]),vec4(x),acc);
    }
    sums[lane]=acc;barrier();
    for(uint reduce=128u;reduce>=64u;reduce>>=1u){
        if(lane<reduce)sums[lane]+=sums[lane+reduce];
        barrier();
    }
    acc=sums[lane];
    for(uint reduce=32u;reduce>0u;reduce>>=1u)acc+=subgroupShuffleDown(acc,reduce);
    if(lane==0u){
        uint at=(token*pc.pieces+piece)*4u;
        partials[at]=acc.x;partials[at+1u]=acc.y;partials[at+2u]=acc.z;partials[at+3u]=acc.w;
    }
}
