#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Key{uint key_q8[];};
layout(set=0,binding=1)readonly buffer Value{uint value_q8[];};
layout(set=0,binding=2)readonly buffer IndexKey{uint index_key_q8[];};
layout(set=0,binding=3)readonly buffer Position{uint position[];};
layout(set=0,binding=4)buffer Records{uint records[];};
layout(set=0,binding=5)buffer IndexHistory{uint index_history[];};
layout(push_constant)uniform Push{
    uint record_layer_slot;
    uint index_layer_slot;
    uint index_capacity;
    uint index_token;
    uint hot_slot;
    uint hot_capacity;
}pc;
const uint KEY_WORDS=136u;
const uint VALUE_WORDS=136u;
const uint INDEX_WORDS=34u;
const uint POSITION_WORDS=3u;
const uint RECORD_WORDS=309u;
void main(){
    uint word=gl_GlobalInvocationID.x;
    if(word>=RECORD_WORDS)return;
    uint record_base=(pc.record_layer_slot*pc.hot_capacity+pc.hot_slot)*RECORD_WORDS;
    if(word<KEY_WORDS){records[record_base+word]=key_q8[word];return;}
    word-=KEY_WORDS;
    if(word<VALUE_WORDS){records[record_base+KEY_WORDS+word]=value_q8[word];return;}
    word-=VALUE_WORDS;
    if(word<INDEX_WORDS){
        uint value=index_key_q8[word];
        records[record_base+KEY_WORDS+VALUE_WORDS+word]=value;
        uint history_base=(pc.index_layer_slot*pc.index_capacity+pc.index_token)*INDEX_WORDS;
        index_history[history_base+word]=value;
        return;
    }
    word-=INDEX_WORDS;
    if(word<POSITION_WORDS)records[record_base+KEY_WORDS+VALUE_WORDS+INDEX_WORDS+word]=position[word];
}
