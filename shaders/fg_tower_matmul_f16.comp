#version 460
layout(local_size_x=16,local_size_y=16,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint weight_word[];};
layout(set=0,binding=1)readonly buffer Input{float input_value[];};
layout(set=0,binding=2)writeonly buffer Output{float output_value[];};
layout(push_constant)uniform Push{uint tokens;uint outputs;uint width;uint stride;uint m_offset;}pc;
shared vec4 tile_w[64][5];
shared vec4 tile_x[64][5];
void main(){
    uint tid=gl_LocalInvocationID.y*16u+gl_LocalInvocationID.x;
    uint lm=gl_LocalInvocationID.x;
    uint ln=gl_LocalInvocationID.y;
    uint m_base=gl_WorkGroupID.x*64u;
    uint n_base=gl_WorkGroupID.y*64u;
    float a00=0.0;float a01=0.0;float a02=0.0;float a03=0.0;
    float a10=0.0;float a11=0.0;float a12=0.0;float a13=0.0;
    float a20=0.0;float a21=0.0;float a22=0.0;float a23=0.0;
    float a30=0.0;float a31=0.0;float a32=0.0;float a33=0.0;
    for(uint k0=0;k0<pc.width;k0+=16u){
        {
            uint r=tid>>2u,c=tid&3u;
            uint m=m_base+r;
            uint kk=k0+c*4u;
            vec4 v=vec4(0.0);
            if(m<pc.outputs&&kk+3u<pc.width){
                uint word=(m*pc.width+kk)>>1u;
                uvec2 hw=uvec2(weight_word[word],weight_word[word+1u]);
                vec2 lo=unpackHalf2x16(hw.x);
                vec2 hi=unpackHalf2x16(hw.y);
                v=vec4(lo.x,lo.y,hi.x,hi.y);
            }
            tile_w[r][c]=v;
        }
        {
            uint r=tid>>2u,c=tid&3u;
            uint n=n_base+r;
            uint kk=k0+c*4u;
            vec4 v=vec4(0.0);
            if(n<pc.tokens){
                if(kk+3u<pc.width)v=vec4(input_value[n*pc.width+kk],
                                        input_value[n*pc.width+kk+1u],
                                        input_value[n*pc.width+kk+2u],
                                        input_value[n*pc.width+kk+3u]);
                else{
                    if(kk<pc.width)v.x=input_value[n*pc.width+kk];
                    if(kk+1u<pc.width)v.y=input_value[n*pc.width+kk+1u];
                    if(kk+2u<pc.width)v.z=input_value[n*pc.width+kk+2u];
                }
            }
            tile_x[r][c]=v;
        }
        barrier();
        for(uint k4=0;k4<4u;k4++){
            vec4 a0=tile_w[lm*4u][k4];vec4 a1=tile_w[lm*4u+1u][k4];
            vec4 a2=tile_w[lm*4u+2u][k4];vec4 a3=tile_w[lm*4u+3u][k4];
            vec4 b0=tile_x[ln*4u][k4];vec4 b1=tile_x[ln*4u+1u][k4];
            vec4 b2=tile_x[ln*4u+2u][k4];vec4 b3=tile_x[ln*4u+3u][k4];
            a00+=a0.x*b0.x;a00+=a0.y*b0.y;a00+=a0.z*b0.z;a00+=a0.w*b0.w;
            a01+=a0.x*b1.x;a01+=a0.y*b1.y;a01+=a0.z*b1.z;a01+=a0.w*b1.w;
            a02+=a0.x*b2.x;a02+=a0.y*b2.y;a02+=a0.z*b2.z;a02+=a0.w*b2.w;
            a03+=a0.x*b3.x;a03+=a0.y*b3.y;a03+=a0.z*b3.z;a03+=a0.w*b3.w;
            a10+=a1.x*b0.x;a10+=a1.y*b0.y;a10+=a1.z*b0.z;a10+=a1.w*b0.w;
            a11+=a1.x*b1.x;a11+=a1.y*b1.y;a11+=a1.z*b1.z;a11+=a1.w*b1.w;
            a12+=a1.x*b2.x;a12+=a1.y*b2.y;a12+=a1.z*b2.z;a12+=a1.w*b2.w;
            a13+=a1.x*b3.x;a13+=a1.y*b3.y;a13+=a1.z*b3.z;a13+=a1.w*b3.w;
            a20+=a2.x*b0.x;a20+=a2.y*b0.y;a20+=a2.z*b0.z;a20+=a2.w*b0.w;
            a21+=a2.x*b1.x;a21+=a2.y*b1.y;a21+=a2.z*b1.z;a21+=a2.w*b1.w;
            a22+=a2.x*b2.x;a22+=a2.y*b2.y;a22+=a2.z*b2.z;a22+=a2.w*b2.w;
            a23+=a2.x*b3.x;a23+=a2.y*b3.y;a23+=a2.z*b3.z;a23+=a2.w*b3.w;
            a30+=a3.x*b0.x;a30+=a3.y*b0.y;a30+=a3.z*b0.z;a30+=a3.w*b0.w;
            a31+=a3.x*b1.x;a31+=a3.y*b1.y;a31+=a3.z*b1.z;a31+=a3.w*b1.w;
            a32+=a3.x*b2.x;a32+=a3.y*b2.y;a32+=a3.z*b2.z;a32+=a3.w*b2.w;
            a33+=a3.x*b3.x;a33+=a3.y*b3.y;a33+=a3.z*b3.z;a33+=a3.w*b3.w;
        }
        barrier();
    }
    uint m=m_base+lm*4u;
    uint n=n_base+ln*4u;
    if(m<pc.outputs){
        if(n<pc.tokens)output_value[n*pc.stride+pc.m_offset+m]=a00;
        if(n+1u<pc.tokens)output_value[(n+1u)*pc.stride+pc.m_offset+m]=a01;
        if(n+2u<pc.tokens)output_value[(n+2u)*pc.stride+pc.m_offset+m]=a02;
        if(n+3u<pc.tokens)output_value[(n+3u)*pc.stride+pc.m_offset+m]=a03;
    }
    if(m+1u<pc.outputs){
        if(n<pc.tokens)output_value[n*pc.stride+pc.m_offset+m+1u]=a10;
        if(n+1u<pc.tokens)output_value[(n+1u)*pc.stride+pc.m_offset+m+1u]=a11;
        if(n+2u<pc.tokens)output_value[(n+2u)*pc.stride+pc.m_offset+m+1u]=a12;
        if(n+3u<pc.tokens)output_value[(n+3u)*pc.stride+pc.m_offset+m+1u]=a13;
    }
    if(m+2u<pc.outputs){
        if(n<pc.tokens)output_value[n*pc.stride+pc.m_offset+m+2u]=a20;
        if(n+1u<pc.tokens)output_value[(n+1u)*pc.stride+pc.m_offset+m+2u]=a21;
        if(n+2u<pc.tokens)output_value[(n+2u)*pc.stride+pc.m_offset+m+2u]=a22;
        if(n+3u<pc.tokens)output_value[(n+3u)*pc.stride+pc.m_offset+m+2u]=a23;
    }
    if(m+3u<pc.outputs){
        if(n<pc.tokens)output_value[n*pc.stride+pc.m_offset+m+3u]=a30;
        if(n+1u<pc.tokens)output_value[(n+1u)*pc.stride+pc.m_offset+m+3u]=a31;
        if(n+2u<pc.tokens)output_value[(n+2u)*pc.stride+pc.m_offset+m+3u]=a32;
        if(n+3u<pc.tokens)output_value[(n+3u)*pc.stride+pc.m_offset+m+3u]=a33;
    }
}
