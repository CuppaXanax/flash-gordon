#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
layout(local_size_x=64) in;
layout(set=0,binding=0) readonly buffer Weights { uint w[]; };
layout(set=0,binding=1) readonly buffer Input { float x[]; };
layout(set=0,binding=2) writeonly buffer Output { float y[]; };
layout(push_constant) uniform Push { uint input_width,output_width,tokens; } pc;
shared float partial[64];
float weight(uint i) {
    return uintBitsToFloat(((w[i>>1u]>>((i&1u)*16u))&65535u)<<16u);
}
void main() {
    uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,token=gl_WorkGroupID.y;
    uint rb=row*pc.input_width,tb=token*pc.input_width;
    float s0=0.0,s1=0.0,s2=0.0,s3=0.0;
    uint i=lane;
    // Match the F32 router's four accumulators and subgroup reduction order.
    for(;i+192u<pc.input_width;i+=256u) {
        s0=fma(weight(rb+i),x[tb+i],s0);
        s1=fma(weight(rb+i+64u),x[tb+i+64u],s1);
        s2=fma(weight(rb+i+128u),x[tb+i+128u],s2);
        s3=fma(weight(rb+i+192u),x[tb+i+192u],s3);
    }
    for(;i<pc.input_width;i+=64u)s0=fma(weight(rb+i),x[tb+i],s0);
    float sum=subgroupAdd((s0+s1)+(s2+s3));
    if(subgroupElect())partial[gl_SubgroupID]=sum;
    barrier();
    if(lane==0u) {
        float total=0.0;
        for(uint group=0u;group<gl_NumSubgroups;group++)total+=partial[group];
        y[token*pc.output_width+row]=total;
    }
}
