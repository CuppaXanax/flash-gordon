#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer InputScores{float input_scores[];};
layout(set=0,binding=1)readonly buffer InputIds{uint input_ids[];};
layout(set=0,binding=2)writeonly buffer OutputScores{float output_scores[];};
layout(set=0,binding=3)writeonly buffer OutputIds{uint output_ids[];};
layout(push_constant)uniform Push{uint count;}pc;
shared float values[4096];shared uint indices[4096];
bool before(float a,uint ai,float b,uint bi){bool ap=ai==0xffffffffu,bp=bi==0xffffffffu;if(ap||bp)return !ap&&bp;bool an=isnan(a)||isinf(a),bn=isnan(b)||isinf(b);if(an||bn)return an!=bn?an:ai<bi;return a>b||(a==b&&ai<bi);}
void main(){uint lane=gl_LocalInvocationID.x,group=gl_WorkGroupID.x,base=group*4096u;for(uint i=lane;i<4096u;i+=256u){uint source=base+i;if(source<pc.count){values[i]=input_scores[source];indices[i]=input_ids[source];}else{values[i]=-1.0/0.0;indices[i]=0xffffffffu;}}barrier();for(uint width=2u;width<=4096u;width<<=1u){for(uint stride=width>>1u;stride>0u;stride>>=1u){for(uint i=lane;i<4096u;i+=256u){uint other=i^stride;if(other>i){bool descending=(i&width)==0u,want_swap=descending?!before(values[i],indices[i],values[other],indices[other]):before(values[i],indices[i],values[other],indices[other]);if(want_swap){float v=values[i];values[i]=values[other];values[other]=v;uint id=indices[i];indices[i]=indices[other];indices[other]=id;}}}barrier();}}uint valid=min(512u,pc.count>base?pc.count-base:0u);for(uint i=lane;i<valid;i+=256u){output_scores[group*512u+i]=values[i];output_ids[group*512u+i]=indices[i];}}
