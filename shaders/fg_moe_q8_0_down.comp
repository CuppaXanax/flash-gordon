#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};layout(set=0,binding=1)readonly buffer Tiles{uint tiles[];};layout(set=0,binding=2)readonly buffer Input{float x[];};layout(set=0,binding=3)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint in_dim;uint row_bytes;uint expert_stride;uint n_used;uint packed_weights;uint reserved;}pc;
const uint PAIR_TILE=8u,TILE_WORDS=9u,INVALID_PAIR=0xffffffffu,Q8_BLOCK=32u,Q8_BYTES=34u;shared float partial[512];uint load_u8(uint off){return(wb[off>>2u]>>((off&3u)*8u))&255u;}uint load_u16(uint off){return load_u8(off)|(load_u8(off+1u)<<8u);}
void main(){uint lid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*8u+(lid>>3u),lane=lid&7u,tile_base=gl_WorkGroupID.y*TILE_WORDS,expert=tiles[tile_base];if(expert==INVALID_PAIR)return;uint weight_idx=pc.packed_weights!=0u?gl_WorkGroupID.y:expert,row_base=weight_idx*pc.expert_stride+min(row,pc.out_dim-1u)*pc.row_bytes;float acc[PAIR_TILE];for(uint slot=0u;slot<PAIR_TILE;slot++)acc[slot]=0.0;if(row<pc.out_dim){for(uint block=0u;block<pc.in_dim/Q8_BLOCK;block++){uint base=row_base+block*Q8_BYTES;float d=unpackHalf2x16(load_u16(base)).x;for(uint i=lane;i<Q8_BLOCK;i+=8u){uint raw=load_u8(base+2u+i);int quant=raw>=128u?int(raw)-256:int(raw);uint column=block*Q8_BLOCK+i;for(uint slot=0u;slot<PAIR_TILE;slot++){uint pair=tiles[tile_base+1u+slot];if(pair!=INVALID_PAIR)acc[slot]=fma(d*float(quant),x[pair*pc.in_dim+column],acc[slot]);}}}}for(uint slot=0u;slot<PAIR_TILE;slot++)partial[slot*64u+lid]=acc[slot];barrier();if(row<pc.out_dim&&lane==0u){for(uint slot=0u;slot<PAIR_TILE;slot++){uint pair=tiles[tile_base+1u+slot];if(pair==INVALID_PAIR)continue;uint offset=slot*64u+lid;y[pair*pc.out_dim+row]=((partial[offset]+partial[offset+4u])+(partial[offset+2u]+partial[offset+6u]))+((partial[offset+1u]+partial[offset+5u])+(partial[offset+3u]+partial[offset+7u]));}}}
