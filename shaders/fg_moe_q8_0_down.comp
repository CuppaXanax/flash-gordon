#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};layout(set=0,binding=1)readonly buffer Tiles{uint tiles[];};layout(set=0,binding=2)readonly buffer Input{float x[];};layout(set=0,binding=3)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint in_dim;uint row_bytes;uint expert_stride;uint n_used;uint packed_weights;uint reserved;}pc;
const uint PAIR_TILE=8u,TILE_WORDS=9u,INVALID_PAIR=0xffffffffu,Q8_BLOCK=32u,Q8_BYTES=34u;shared float partial[512];
void main(){uint lid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*8u+(lid>>3u),lane=lid&7u,tile_base=gl_WorkGroupID.y*TILE_WORDS,expert=tiles[tile_base];if(expert==INVALID_PAIR)return;uint weight_idx=pc.packed_weights!=0u?gl_WorkGroupID.y:expert,row_base=weight_idx*pc.expert_stride+min(row,pc.out_dim-1u)*pc.row_bytes;float acc[PAIR_TILE];for(uint slot=0u;slot<PAIR_TILE;slot++)acc[slot]=0.0;if(row<pc.out_dim){for(uint block=0u;block<pc.in_dim/Q8_BLOCK;block++){uint base=row_base+block*Q8_BYTES;
/* Load scale once per block */
uint sw=wb[base>>2u];uint sp=(base&3u)*8u;uint sr=(sw>>sp)&0xFFFFu;if((base&3u)==3u){sr=(sw>>24u)|((wb[(base>>2u)+1u]&0xFFu)<<8u);}float d=unpackHalf2x16(sr).x;
/* 4 quants per load: lane processes elements lane*4..lane*4+3 within block */
uint qoff=base+2u+lane*4u;uint qw=qoff>>2u;uint qs=(qoff&3u)*8u;uint combined;if(qs==0u){combined=wb[qw];}else{combined=(wb[qw]>>qs)|(wb[qw+1u]<<(32u-qs));}
int q0=int(combined&0xFFu);q0-=(q0>=128)?256:0;int q1=int((combined>>8u)&0xFFu);q1-=(q1>=128)?256:0;int q2=int((combined>>16u)&0xFFu);q2-=(q2>=128)?256:0;int q3=int(combined>>24u);q3-=(q3>=128)?256:0;
uint col=block*Q8_BLOCK+lane*4u;for(uint slot=0u;slot<PAIR_TILE;slot++){uint pair=tiles[tile_base+1u+slot];if(pair!=INVALID_PAIR){uint px=pair*pc.in_dim+col;acc[slot]+=d*(float(q0)*x[px]+float(q1)*x[px+1u]+float(q2)*x[px+2u]+float(q3)*x[px+3u]);}}}}for(uint slot=0u;slot<PAIR_TILE;slot++)partial[slot*64u+lid]=acc[slot];barrier();if(row<pc.out_dim&&lane==0u){for(uint slot=0u;slot<PAIR_TILE;slot++){uint pair=tiles[tile_base+1u+slot];if(pair==INVALID_PAIR)continue;uint offset=slot*64u+lid;y[pair*pc.out_dim+row]=((partial[offset]+partial[offset+4u])+(partial[offset+2u]+partial[offset+6u]))+((partial[offset+1u]+partial[offset+5u])+(partial[offset+3u]+partial[offset+7u]));}}}
