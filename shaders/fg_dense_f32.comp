layout(local_size_x=64,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Weights{float weight[];};layout(set=0,binding=1)readonly buffer Input{float input_value[];};layout(set=0,binding=2)writeonly buffer Output{float output_value[];};layout(push_constant)uniform Push{uint input_width;uint output_width;uint tokens;}pc;shared float partial[64];
void main(){uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,token=gl_WorkGroupID.y;if(row>=pc.output_width||token>=pc.tokens)return;uint row_base=row*pc.input_width,token_base=token*pc.input_width;float s0=0.0,s1=0.0,s2=0.0,s3=0.0;uint i=lane;for(;i+192u<pc.input_width;i+=256u){s0=fma(weight[row_base+i],input_value[token_base+i],s0);s1=fma(weight[row_base+i+64u],input_value[token_base+i+64u],s1);s2=fma(weight[row_base+i+128u],input_value[token_base+i+128u],s2);s3=fma(weight[row_base+i+192u],input_value[token_base+i+192u],s3);}for(;i<pc.input_width;i+=64u)s0=fma(weight[row_base+i],input_value[token_base+i],s0);float sum=subgroupAdd((s0+s1)+(s2+s3));if(subgroupElect())partial[gl_SubgroupID]=sum;barrier();if(lane==0u){float total=0.0;for(uint subgroup=0u;subgroup<gl_NumSubgroups;subgroup++)total+=partial[subgroup];output_value[token*pc.output_width+row]=total;}}
