#version 460
/* Batched split-K QSA attention, stage 2: each workgroup owns one
 * (head, query) pair, combines its splits deterministically in split order
 * and applies the query's output gate.  Math is identical to
 * fg_qsa_attention_merge. */
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Partials{float partials[];};
layout(set=0,binding=1)readonly buffer Gate{float gate[];};
layout(set=0,binding=2)writeonly buffer Output{float output_value[];};
layout(push_constant)uniform Push{uint splits;uint query_count;uint query_stride;}pc;
void main(){
    uint head=gl_WorkGroupID.x,q=gl_WorkGroupID.y,lane=gl_LocalInvocationID.x;
    if(head>=24u||pc.splits==0u||q>=pc.query_count)return;
    float maximum=-3.402823466e38;
    for(uint split=0u;split<pc.splits;split++)
        maximum=max(maximum,partials[((q*24u+head)*pc.splits+split)*258u+256u]);
    float numerator=0.0,denominator=0.0;
    for(uint split=0u;split<pc.splits;split++){
        uint base=((q*24u+head)*pc.splits+split)*258u;
        float weight=partials[base+257u]>0.0?exp(partials[base+256u]-maximum):0.0;
        numerator=fma(weight,partials[base+lane],numerator);
        denominator=fma(weight,partials[base+257u],denominator);
    }
    float sigmoid_gate=1.0/(1.0+exp(-gate[q*pc.query_stride+head*256u+lane]));
    output_value[q*pc.query_stride+head*256u+lane]=numerator/denominator*sigmoid_gate;
}
