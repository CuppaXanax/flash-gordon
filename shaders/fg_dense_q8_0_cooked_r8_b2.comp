#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

/* Batch-2 decode MMV: one weight pass for two tokens.
 *
 * The r8 decode kernel computes 8 output rows for one token with two
 * accumulators (rows 0-3, rows 4-7).  This variant keeps both tokens in one
 * workgroup: the weight tile (scales + q8 bytes) is loaded once per cohort
 * and multiplied into four accumulators (2 row halves x 2 tokens).  Each
 * token's arithmetic sequence is exactly the work of
 * fg_dense_q8_0_cooked_r8.comp (same fma order, same subgroupAdd tree, same
 * cross-subgroup order), so per-token output is bit-identical to two
 * single-token r8 dispatches while the weight bytes are read once.
 *
 * Grid: (ceil(out_dim/8), 1, 1).  Input is two contiguous token rows; output
 * is out[token*out_dim + row]. */

layout(local_size_x=128,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};
layout(set=0,binding=0)readonly buffer WeightsVector{uvec4 wb4[];};
layout(set=0,binding=1)readonly buffer Input{vec4 x4[];};
layout(set=0,binding=2)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint n_tok;uint blocks;uint tile_bytes;float scale;}pc;
shared vec4 subgroup_sum[4][64];

void main(){
    uint local_id=gl_LocalInvocationID.x;
    uint cohort=local_id>>3u,cohort_lane=local_id&7u,first_row=gl_WorkGroupID.x*8u;
    if(first_row>=pc.out_dim||pc.n_tok<2u)return;
    uint tile_base=(first_row>>4u)*pc.tile_bytes,tile_row=first_row&15u;
    uint quant_offset=(16u*pc.blocks*2u+63u)&~63u;
    uvec4 rows0=uvec4(tile_row,tile_row+1u,tile_row+2u,tile_row+3u),rows1=rows0+4u;
    uvec4 quant_base0=tile_base+quant_offset+rows0*pc.blocks*32u,quant_base1=tile_base+quant_offset+rows1*pc.blocks*32u;
    uint input_base0=0u,input_base1=pc.blocks*8u,cohorts=(pc.blocks+15u)/16u;
    vec4 accumulator00=vec4(0.0),accumulator01=vec4(0.0),accumulator10=vec4(0.0),accumulator11=vec4(0.0);
    for(uint group=0u;group<cohorts;group++){
        uint block=group*16u+cohort;bool live=block<pc.blocks;
        uint safe_block=live?block:(pc.blocks-1u);
        uint scale_word=(tile_base>>2u)+safe_block*8u+(tile_row>>1u);
        uvec4 scales=wb4[scale_word>>2u];
        vec4 delta0=live?vec4(unpackHalf2x16(scales.x),unpackHalf2x16(scales.y)):vec4(0.0);
        vec4 delta1=live?vec4(unpackHalf2x16(scales.z),unpackHalf2x16(scales.w)):vec4(0.0);
        uint word_offset=safe_block*32u+cohort_lane*4u;
        uvec4 packed0=uvec4(wb[(quant_base0.x+word_offset)>>2u],wb[(quant_base0.y+word_offset)>>2u],wb[(quant_base0.z+word_offset)>>2u],wb[(quant_base0.w+word_offset)>>2u]);
        uvec4 packed1=uvec4(wb[(quant_base1.x+word_offset)>>2u],wb[(quant_base1.y+word_offset)>>2u],wb[(quant_base1.z+word_offset)>>2u],wb[(quant_base1.w+word_offset)>>2u]);
        vec4 input_value0=live?x4[input_base0+safe_block*8u+cohort_lane]:vec4(0.0);
        vec4 input_value1=live?x4[input_base1+safe_block*8u+cohort_lane]:vec4(0.0);
        vec4 u0=vec4(unpack8(int32_t(packed0.x))),u1=vec4(unpack8(int32_t(packed0.y))),u2=vec4(unpack8(int32_t(packed0.z))),u3=vec4(unpack8(int32_t(packed0.w)));
        vec4 v0=vec4(unpack8(int32_t(packed1.x))),v1=vec4(unpack8(int32_t(packed1.y))),v2=vec4(unpack8(int32_t(packed1.z))),v3=vec4(unpack8(int32_t(packed1.w)));
        vec4 products00=vec4(dot(u0,input_value0),dot(u1,input_value0),dot(u2,input_value0),dot(u3,input_value0));
        vec4 products01=vec4(dot(v0,input_value0),dot(v1,input_value0),dot(v2,input_value0),dot(v3,input_value0));
        vec4 products10=vec4(dot(u0,input_value1),dot(u1,input_value1),dot(u2,input_value1),dot(u3,input_value1));
        vec4 products11=vec4(dot(v0,input_value1),dot(v1,input_value1),dot(v2,input_value1),dot(v3,input_value1));
        accumulator00=fma(delta0,products00,accumulator00);accumulator01=fma(delta1,products01,accumulator01);
        accumulator10=fma(delta0,products10,accumulator10);accumulator11=fma(delta1,products11,accumulator11);
    }
    vec4 reduced00=vec4(subgroupAdd(accumulator00.x),subgroupAdd(accumulator00.y),subgroupAdd(accumulator00.z),subgroupAdd(accumulator00.w));
    vec4 reduced01=vec4(subgroupAdd(accumulator01.x),subgroupAdd(accumulator01.y),subgroupAdd(accumulator01.z),subgroupAdd(accumulator01.w));
    vec4 reduced10=vec4(subgroupAdd(accumulator10.x),subgroupAdd(accumulator10.y),subgroupAdd(accumulator10.z),subgroupAdd(accumulator10.w));
    vec4 reduced11=vec4(subgroupAdd(accumulator11.x),subgroupAdd(accumulator11.y),subgroupAdd(accumulator11.z),subgroupAdd(accumulator11.w));
    if(subgroupElect()){subgroup_sum[0][gl_SubgroupID]=reduced00;subgroup_sum[1][gl_SubgroupID]=reduced01;subgroup_sum[2][gl_SubgroupID]=reduced10;subgroup_sum[3][gl_SubgroupID]=reduced11;}
    barrier();
    if(local_id==0u){vec4 total00=vec4(0.0),total01=vec4(0.0),total10=vec4(0.0),total11=vec4(0.0);for(uint subgroup=0u;subgroup<gl_NumSubgroups;subgroup++){total00+=subgroup_sum[0][subgroup];total01+=subgroup_sum[1][subgroup];total10+=subgroup_sum[2][subgroup];total11+=subgroup_sum[3][subgroup];}for(uint row=0u;row<4u;row++){y[first_row+row]=total00[row]*pc.scale;y[first_row+4u+row]=total01[row]*pc.scale;y[pc.out_dim+first_row+row]=total10[row]*pc.scale;y[pc.out_dim+first_row+4u+row]=total11[row]*pc.scale;}}
}
