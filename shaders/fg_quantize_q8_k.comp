#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Input{float x[];};layout(set=0,binding=1)writeonly buffer Output{uint q8[];};layout(push_constant)uniform Push{uint in_dim;uint blocks;uint n_tok;}pc;
const uint QK=256u,WORDS=74u;shared float maximum[64];shared int sum4[64];shared int block_sum[16];
uint pack4(int a,int b,int c,int d){return(uint(a)&255u)|((uint(b)&255u)<<8u)|((uint(c)&255u)<<16u)|((uint(d)&255u)<<24u);}
void main(){uint lane=gl_LocalInvocationID.x,block=gl_WorkGroupID.x,token=gl_WorkGroupID.y,index=token*pc.in_dim+block*QK+lane*4u,output_base=(token*pc.blocks+block)*WORDS;float local_max=0.0;for(uint i=0u;i<4u;i++)local_max=max(local_max,abs(x[index+i]));maximum[lane]=local_max;barrier();for(uint stride=32u;stride>0u;stride>>=1u){if(lane<stride)maximum[lane]=max(maximum[lane],maximum[lane+stride]);barrier();}float d=maximum[0]/127.0,inv=d!=0.0?1.0/d:0.0;int value[4];int local_sum=0;for(uint i=0u;i<4u;i++){value[i]=int(clamp(roundEven(x[index+i]*inv),-127.0,127.0));local_sum+=value[i];}if(lane==0u){q8[output_base]=floatBitsToUint(d);q8[output_base+1u]=0u;}q8[output_base+2u+lane]=pack4(value[0],value[1],value[2],value[3]);sum4[lane]=local_sum;barrier();if((lane&3u)==0u)block_sum[lane>>2u]=sum4[lane]+sum4[lane+1u]+sum4[lane+2u]+sum4[lane+3u];barrier();if(lane<8u)q8[output_base+66u+lane]=(uint(block_sum[lane*2u])&65535u)|((uint(block_sum[lane*2u+1u])&65535u)<<16u);}
