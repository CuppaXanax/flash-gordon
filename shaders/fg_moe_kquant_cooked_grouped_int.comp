#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_integer_dot_product : enable
#ifdef GL_EXT_integer_dot_product
#define FG_INTEGER_DOT 1
#endif

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint wb[]; };
layout(set = 0, binding = 1) readonly buffer Activation { uint q8[]; };
layout(set = 0, binding = 2) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint blocks;
    uint tile_bytes;
    uint expert_stride;
    uint type;
    uint tokens;
} pc;

const uint Q4_K = 12u;
const uint Q5_K = 13u;
const uint TOP_K = 10u;
const uint PAIR_TILE = 16u;
const uint TILE_WORDS = 17u;
const uint INVALID = 0xffffffffu;
const uint Q8K_WORDS = 74u;
shared uint metadata[32];
shared uint pair_ids[PAIR_TILE];
shared float sums[PAIR_TILE][64];

uint metadata_byte(uint row_slot, uint offset) {
    uint word = metadata[row_slot * 4u + 1u + (offset >> 2u)];
    return (word >> ((offset & 3u) * 8u)) & 255u;
}

void scale_min(uint row_slot, uint group, out uint scale, out uint minimum) {
    uint first = metadata_byte(row_slot, group);
    if (group < 4u) {
        scale = first & 63u;
        minimum = metadata_byte(row_slot, 4u + group) & 63u;
    } else {
        uint upper = metadata_byte(row_slot, 4u + group);
        uint lower = metadata_byte(row_slot, group - 4u);
        scale = (upper & 15u) | ((lower >> 6u) << 4u);
        minimum = (upper >> 4u) | ((first >> 6u) << 4u);
    }
}

int signed_half(uint packed, uint upper) {
    uint value = upper == 0u ? packed & 65535u : packed >> 16u;
    return value >= 32768u ? int(value) - 65536 : int(value);
}

uint packed_quant_word(uint packed, uint high, uint group) {
    return ((packed >> ((group & 1u) * 4u)) & 0x0f0f0f0fu) |
        (((high >> group) & 0x01010101u) << 4u);
}

int group_dot4(uint weight_word, uint activation_word) {
#ifdef FG_INTEGER_DOT
    return dotPacked4x8EXT(floatBitsToInt(uintBitsToFloat(weight_word)),
                           floatBitsToInt(uintBitsToFloat(activation_word)));
#else
    return int(dot(vec4(unpack8(int(weight_word))),
                   vec4(unpack8(int(activation_word)))));
#endif
}

#define FG_DOT_PAIR(PS, ACC) { \
    uint pair_id = pair_ids[PS]; \
    if (pair_id != INVALID) { \
        uint activation_base = (pair_id / TOP_K) * pc.blocks * Q8K_WORDS + \
            block * Q8K_WORDS; \
        float activation_delta = uintBitsToFloat(q8[activation_base]); \
        uint packed_activation = q8[activation_base + 2u + group * 8u + lane]; \
        int group_dot = group_dot4(weight_word, packed_activation); \
        ACC = fma(delta_min.x * activation_delta, \
            float(int(scale_value) * group_dot), ACC); \
    } }

#define FG_MIN_PAIR(PS, ACC) { \
    uint pair_id = pair_ids[PS]; \
    if (pair_id != INVALID) { \
        uint activation_base = (pair_id / TOP_K) * pc.blocks * Q8K_WORDS + \
            block * Q8K_WORDS; \
        float activation_delta = uintBitsToFloat(q8[activation_base]); \
        int minimum_dot = 0; \
        for (uint group = begin; group < end; group++) { \
            uint scale_value; \
            uint minimum_value; \
            scale_min(row_slot, group, scale_value, minimum_value); \
            uint packed_sums = q8[activation_base + 66u + group]; \
            minimum_dot += int(minimum_value) * \
                (signed_half(packed_sums, 0u) + signed_half(packed_sums, 1u)); \
        } \
        ACC = fma(-delta_min.y * activation_delta, float(minimum_dot), ACC); \
    } }

void main() {
    uint local_id = gl_LocalInvocationID.x;
    uint row_slot = local_id >> 3u;
    uint lane = local_id & 7u;
    uint row = gl_WorkGroupID.x * 8u + row_slot;
    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;
    if (local_id < PAIR_TILE) pair_ids[local_id] = tiles[tile_base + 1u + local_id];
    uint row_tile = row >> 3u;
    uint tile_row = row & 7u;
    bool row_live = row < pc.out_dim;
    float acc0 = 0.0, acc1 = 0.0, acc2 = 0.0, acc3 = 0.0;
    float acc4 = 0.0, acc5 = 0.0, acc6 = 0.0, acc7 = 0.0;
    float acc8 = 0.0, acc9 = 0.0, acc10 = 0.0, acc11 = 0.0;
    float acc12 = 0.0, acc13 = 0.0, acc14 = 0.0, acc15 = 0.0;
    barrier();

    for (uint block = 0u; block < pc.blocks; block++) {
        uint block_tile_bytes = pc.type == Q4_K ? 1152u : 1408u;
        uint block_base = expert * pc.expert_stride + row_tile * pc.tile_bytes +
            block * block_tile_bytes;
        if (lane == 0u)
            metadata[row_slot * 4u] = row_live ?
                wb[(block_base + tile_row * 4u) >> 2u] : 0u;
        if (lane < 3u)
            metadata[row_slot * 4u + 1u + lane] = row_live ?
                wb[(block_base + 32u + tile_row * 12u + lane * 4u) >> 2u] : 0u;
        barrier();

        if (row_live) {
            vec2 delta_min = unpackHalf2x16(metadata[row_slot * 4u]);
            uint high = pc.type == Q5_K ?
                wb[(block_base + 128u + tile_row * 32u + lane * 4u) >> 2u] : 0u;
            uint quant_base = block_base + (pc.type == Q5_K ? 384u : 128u) +
                tile_row * 128u + lane * 4u;

            for (uint group = 0u; group < 8u; group++) {
                uint scale_value;
                uint minimum_value;
                scale_min(row_slot, group, scale_value, minimum_value);
                uint packed_quant = wb[(quant_base + (group >> 1u) * 32u) >> 2u];
                uint weight_word = pc.type == Q5_K ?
                    packed_quant_word(packed_quant, high, group) :
                    (packed_quant >> ((group & 1u) * 4u)) & 0x0f0f0f0fu;
                FG_DOT_PAIR(0, acc0)
                FG_DOT_PAIR(1, acc1)
                FG_DOT_PAIR(2, acc2)
                FG_DOT_PAIR(3, acc3)
                FG_DOT_PAIR(4, acc4)
                FG_DOT_PAIR(5, acc5)
                FG_DOT_PAIR(6, acc6)
                FG_DOT_PAIR(7, acc7)
                FG_DOT_PAIR(8, acc8)
                FG_DOT_PAIR(9, acc9)
                FG_DOT_PAIR(10, acc10)
                FG_DOT_PAIR(11, acc11)
                FG_DOT_PAIR(12, acc12)
                FG_DOT_PAIR(13, acc13)
                FG_DOT_PAIR(14, acc14)
                FG_DOT_PAIR(15, acc15)
            }

            if ((pc.type == Q5_K && lane == 0u) ||
                (pc.type == Q4_K && lane < 4u)) {
                uint begin = pc.type == Q5_K ? 0u : lane * 2u;
                uint end = pc.type == Q5_K ? 8u : begin + 2u;
                FG_MIN_PAIR(0, acc0)
                FG_MIN_PAIR(1, acc1)
                FG_MIN_PAIR(2, acc2)
                FG_MIN_PAIR(3, acc3)
                FG_MIN_PAIR(4, acc4)
                FG_MIN_PAIR(5, acc5)
                FG_MIN_PAIR(6, acc6)
                FG_MIN_PAIR(7, acc7)
                FG_MIN_PAIR(8, acc8)
                FG_MIN_PAIR(9, acc9)
                FG_MIN_PAIR(10, acc10)
                FG_MIN_PAIR(11, acc11)
                FG_MIN_PAIR(12, acc12)
                FG_MIN_PAIR(13, acc13)
                FG_MIN_PAIR(14, acc14)
                FG_MIN_PAIR(15, acc15)
            }
        }
        barrier();
    }

    sums[0][local_id] = acc0;
    sums[1][local_id] = acc1;
    sums[2][local_id] = acc2;
    sums[3][local_id] = acc3;
    sums[4][local_id] = acc4;
    sums[5][local_id] = acc5;
    sums[6][local_id] = acc6;
    sums[7][local_id] = acc7;
    sums[8][local_id] = acc8;
    sums[9][local_id] = acc9;
    sums[10][local_id] = acc10;
    sums[11][local_id] = acc11;
    sums[12][local_id] = acc12;
    sums[13][local_id] = acc13;
    sums[14][local_id] = acc14;
    sums[15][local_id] = acc15;
    barrier();
    if (row_live && lane == 0u) {
        uint offset = row_slot * 8u;
        for (uint pair_slot = 0u; pair_slot < PAIR_TILE; pair_slot++) {
            uint pair = pair_ids[pair_slot];
            if (pair == INVALID || pair >= pc.tokens * TOP_K) continue;
            float value =
                ((sums[pair_slot][offset] + sums[pair_slot][offset + 4u]) +
                 (sums[pair_slot][offset + 2u] + sums[pair_slot][offset + 6u])) +
                ((sums[pair_slot][offset + 1u] + sums[pair_slot][offset + 5u]) +
                 (sums[pair_slot][offset + 3u] + sums[pair_slot][offset + 7u]));
            y[pair * pc.out_dim + row] = value;
        }
    }
}
