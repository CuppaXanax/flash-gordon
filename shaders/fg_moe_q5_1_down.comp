#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};layout(set=0,binding=1)readonly buffer Tiles{uint tiles[];};layout(set=0,binding=2)readonly buffer Input{float x[];};layout(set=0,binding=3)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint in_dim;uint row_bytes;uint expert_stride;uint n_used;uint packed_weights;uint reserved;}pc;
const uint PAIR_TILE=8u,TILE_WORDS=9u,INVALID_PAIR=0xffffffffu,Q5_1_BLOCK=32u,Q5_1_BYTES=24u;shared float partial[512];
uint load_u8(uint off){return(wb[off>>2u]>>((off&3u)*8u))&255u;}uint load_u16(uint off){return load_u8(off)|(load_u8(off+1u)<<8u);}float load_f16(uint off){return unpackHalf2x16(load_u16(off)).x;}uint q5_1_value(uint base,uint i){uint qh=load_u8(base+4u+(i>>3u));uint hi=(qh>>(i&7u))&1u;uint j=i&15u;uint ql=load_u8(base+8u+j);uint lo=i<16u?(ql&15u):(ql>>4u);return lo|(hi<<4u);}
void main(){uint lid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*8u+(lid>>3u),lane=lid&7u,tile_base=gl_WorkGroupID.y*TILE_WORDS,expert=tiles[tile_base];if(expert==INVALID_PAIR)return;uint weight_idx=pc.packed_weights!=0u?gl_WorkGroupID.y:expert;uint row_base=weight_idx*pc.expert_stride+min(row,pc.out_dim-1u)*pc.row_bytes;float acc[PAIR_TILE];for(uint u=0u;u<PAIR_TILE;u++)acc[u]=0.0;if(row<pc.out_dim){uint blocks=pc.in_dim/Q5_1_BLOCK;for(uint b=0u;b<blocks;b++){uint base=row_base+b*Q5_1_BYTES;float d=load_f16(base),m=load_f16(base+2u);uint i0=lane*4u;for(uint j=0u;j<4u;j++){uint i=i0+j;float w=fma(d,float(q5_1_value(base,i)),m);uint col=b*Q5_1_BLOCK+i;for(uint u=0u;u<PAIR_TILE;u++){uint p=tiles[tile_base+1u+u];if(p!=INVALID_PAIR)acc[u]=fma(w,x[p*pc.in_dim+col],acc[u]);}}}}for(uint u=0u;u<PAIR_TILE;u++)partial[u*64u+lid]=acc[u];barrier();if(row<pc.out_dim&&lane==0u){for(uint u=0u;u<PAIR_TILE;u++){uint p=tiles[tile_base+1u+u];if(p==INVALID_PAIR)continue;uint o=u*64u+lid;y[p*pc.out_dim+row]=((partial[o]+partial[o+4u])+(partial[o+2u]+partial[o+6u]))+((partial[o+1u]+partial[o+5u])+(partial[o+3u]+partial[o+7u]));}}}
