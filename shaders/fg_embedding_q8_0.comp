uint load_byte(uint offset){return(packed[offset>>2u]>>((offset&3u)*8u))&255u;}
void main(){uint index=gl_GlobalInvocationID.x,total=pc.width*pc.copies;if(index>=total||pc.token>=pc.rows)return;uint element=index%pc.width,row_bytes=(pc.width/32u)*34u,base=pc.token*row_bytes+(element>>5u)*34u;uint half_bits=load_byte(base)|(load_byte(base+1u)<<8u),q=load_byte(base+2u+(element&31u));int signed_q=q>=128u?int(q)-256:int(q);output_value[index]=unpackHalf2x16(half_bits).x*float(signed_q);}
