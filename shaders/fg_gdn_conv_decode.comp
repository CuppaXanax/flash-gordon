#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Projection{float projection[];};
layout(set=0,binding=1)readonly buffer Weight{float weight[];};
layout(set=0,binding=1)readonly buffer WeightVector{vec4 weight4[];};
layout(set=0,binding=2)buffer State{float state[];};
layout(set=0,binding=2)buffer StateVector{vec4 state4[];};
layout(set=0,binding=3)writeonly buffer Output{float output_value[];};
layout(push_constant)uniform Push{uint channels;}pc;
void main(){uint channel=gl_GlobalInvocationID.x;if(channel>=pc.channels)return;vec4 s=state4[channel];vec4 w=weight4[channel];float current=projection[channel];float value=w.x*s.y+w.y*s.z+w.z*s.w+w.w*current;state4[channel]=vec4(s.y,s.z,s.w,current);output_value[channel]=value/(1.0+exp(-value));}
