#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer SelectedIds{uint selected_ids[];};
layout(set=0,binding=1)readonly buffer SlotTable{uint slot_table[];};
layout(set=0,binding=2)writeonly buffer Resolved{uint resolved[];};
layout(set=0,binding=3)writeonly buffer Flags{uint flags[];};
layout(push_constant)uniform Push{uint count;uint block_limit;uint layer_base;}pc;
shared uint misses;
void main(){
    uint lane=gl_LocalInvocationID.x;
    if(lane==0u)misses=0u;
    barrier();
    uint i=gl_GlobalInvocationID.x;
    if(i<pc.count){
        uint block=selected_ids[i];
        uint slot=0xffffffffu;
        if(block<pc.block_limit)slot=slot_table[pc.layer_base+block];
        resolved[i]=slot;
        if(slot==0xffffffffu)atomicAdd(misses,1u);
    }
    barrier();
    if(lane==0u)flags[gl_WorkGroupID.x]=misses;
}
