#version 460
#extension GL_KHR_shader_subgroup_shuffle : require

layout(local_size_x = 64, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Weights { uint wb[]; };
layout(set = 0, binding = 1) readonly buffer Tiles { uint tiles[]; };
layout(set = 0, binding = 2) readonly buffer Input { vec4 x4[]; };
layout(set = 0, binding = 3) writeonly buffer Output { float y[]; };

layout(push_constant) uniform Push {
    uint out_dim;
    uint in_dim;
    uint blocks;
    uint tile_bytes;
    uint expert_stride;
    uint tokens;
} pc;

const uint TOP_K = 10u;
const uint PAIR_TILE = 4u;
const uint TILE_WORDS = 5u;
const uint INVALID = 0xffffffffu;
const uint ROWS = 4u;
const uint ROWS_PER_WORKGROUP = 32u;
const uint COOK_ROWS = 16u;
const uint BLOCK_TILE_BYTES = 384u;

/* One row lane of a cooked Q5_1 block: the low nibbles of the four packed
   bytes come from lanes 0-3, the high nibbles from lanes 4-7, and the fifth
   bit of every value comes from the row's high word. */
vec4 q5_1_weight(uint packed, uint high, uint lane, vec2 scale_min) {
    uint low = (lane < 4u) ? packed : (packed >> 4u);
    uint bits = high >> (lane * 4u);
    uvec4 value = uvec4((low >> 0u) & 15u, (low >> 8u) & 15u,
                        (low >> 16u) & 15u, (low >> 24u) & 15u) |
        (uvec4(bits & 1u, (bits >> 1u) & 1u,
               (bits >> 2u) & 1u, (bits >> 3u) & 1u) << 4u);
    return fma(vec4(value), vec4(scale_min.x), vec4(scale_min.y));
}

/* One product lane: the input vector is shared by the thread's four rows and
   the live flag is tested once for all of them.  The min term is already
   folded into the weight vector, so four issued FMAs cover the four MACs of
   a (row, pair, 32-value block) product without the dot tree's three
   horizontal adds and without widening the scalar accumulators. */
#define FG_ACC(A, W, S) { \
    A = fma(W.x, S.x, A); \
    A = fma(W.y, S.y, A); \
    A = fma(W.z, S.z, A); \
    A = fma(W.w, S.w, A); }

#define FG_PAIR(P, S, L) { \
    if (L) { \
        FG_ACC(acc0##P, w0, S) \
        FG_ACC(acc1##P, w1, S) \
        FG_ACC(acc2##P, w2, S) \
        FG_ACC(acc3##P, w3, S) \
    } }

/* Write the four rows of one pair slot after the K-segment reduction. */
void store_pair(uint pair, uint row0, float v0, float v1, float v2, float v3) {
    if (pair == INVALID || pair >= pc.tokens * TOP_K) return;
    if (row0 + 0u < pc.out_dim) y[pair * pc.out_dim + row0 + 0u] = v0;
    if (row0 + 1u < pc.out_dim) y[pair * pc.out_dim + row0 + 1u] = v1;
    if (row0 + 2u < pc.out_dim) y[pair * pc.out_dim + row0 + 2u] = v2;
    if (row0 + 3u < pc.out_dim) y[pair * pc.out_dim + row0 + 3u] = v3;
}

/* Three-step XOR butterfly over the eight lanes of a row group: every lane
   ends with the full K-segment sum, so the shared staging array, its barrier
   and the serialised lane-0 tree are all gone. */
#define FG_REDUCE(A) { \
    A += subgroupShuffleXor(A, 1u); \
    A += subgroupShuffleXor(A, 2u); \
    A += subgroupShuffleXor(A, 4u); }

void main() {
    uint lid = gl_LocalInvocationID.x;
    uint lane = lid & 7u;
    uint row_group = lid >> 3u;
    uint row0 = gl_WorkGroupID.x * ROWS_PER_WORKGROUP + row_group * ROWS;

    uint tile_base = gl_WorkGroupID.y * TILE_WORDS;
    uint expert = tiles[tile_base];
    if (expert == INVALID) return;

    uint p0 = tiles[tile_base + 1u];
    uint p1 = tiles[tile_base + 2u];
    uint p2 = tiles[tile_base + 3u];
    uint p3 = tiles[tile_base + 4u];

    bool live0 = p0 != INVALID;
    bool live1 = p1 != INVALID;
    bool live2 = p2 != INVALID;
    bool live3 = p3 != INVALID;

    bool row_live0 = row0 < pc.out_dim;
    bool row_live1 = row0 + 1u < pc.out_dim;
    bool row_live2 = row0 + 2u < pc.out_dim;
    bool row_live3 = row0 + 3u < pc.out_dim;

    uint row_tile = row0 >> 4u;
    uint tile_row = row0 & 15u;
    uint wr = expert * pc.expert_stride + row_tile * pc.tile_bytes;
    uint quant_lane = (lane & 3u) * 4u;

    float acc00 = 0.0, acc01 = 0.0, acc02 = 0.0, acc03 = 0.0;
    float acc10 = 0.0, acc11 = 0.0, acc12 = 0.0, acc13 = 0.0;
    float acc20 = 0.0, acc21 = 0.0, acc22 = 0.0, acc23 = 0.0;
    float acc30 = 0.0, acc31 = 0.0, acc32 = 0.0, acc33 = 0.0;

    for (uint block = 0u; block < pc.blocks; block++) {
        uint bb = wr + block * BLOCK_TILE_BYTES;

        uint sw0 = row_live0 ? wb[(bb + tile_row * 4u) >> 2u] : 0u;
        uint sw1 = row_live1 ? wb[(bb + (tile_row + 1u) * 4u) >> 2u] : 0u;
        uint sw2 = row_live2 ? wb[(bb + (tile_row + 2u) * 4u) >> 2u] : 0u;
        uint sw3 = row_live3 ? wb[(bb + (tile_row + 3u) * 4u) >> 2u] : 0u;
        vec2 sm0 = unpackHalf2x16(sw0);
        vec2 sm1 = unpackHalf2x16(sw1);
        vec2 sm2 = unpackHalf2x16(sw2);
        vec2 sm3 = unpackHalf2x16(sw3);

        uint hw0 = row_live0 ? wb[(bb + 64u + tile_row * 4u) >> 2u] : 0u;
        uint hw1 = row_live1 ? wb[(bb + 64u + (tile_row + 1u) * 4u) >> 2u] : 0u;
        uint hw2 = row_live2 ? wb[(bb + 64u + (tile_row + 2u) * 4u) >> 2u] : 0u;
        uint hw3 = row_live3 ? wb[(bb + 64u + (tile_row + 3u) * 4u) >> 2u] : 0u;

        uint qw0 = row_live0 ? wb[(bb + 128u + tile_row * 16u + quant_lane) >> 2u] : 0u;
        uint qw1 = row_live1 ? wb[(bb + 128u + (tile_row + 1u) * 16u + quant_lane) >> 2u] : 0u;
        uint qw2 = row_live2 ? wb[(bb + 128u + (tile_row + 2u) * 16u + quant_lane) >> 2u] : 0u;
        uint qw3 = row_live3 ? wb[(bb + 128u + (tile_row + 3u) * 16u + quant_lane) >> 2u] : 0u;

        uint input_base = block * 8u + lane;
        vec4 a0 = live0 ? x4[p0 * (pc.in_dim >> 2u) + input_base] : vec4(0.0);
        vec4 a1 = live1 ? x4[p1 * (pc.in_dim >> 2u) + input_base] : vec4(0.0);
        vec4 a2 = live2 ? x4[p2 * (pc.in_dim >> 2u) + input_base] : vec4(0.0);
        vec4 a3 = live3 ? x4[p3 * (pc.in_dim >> 2u) + input_base] : vec4(0.0);

        vec4 w0 = q5_1_weight(qw0, hw0, lane, sm0);
        vec4 w1 = q5_1_weight(qw1, hw1, lane, sm1);
        vec4 w2 = q5_1_weight(qw2, hw2, lane, sm2);
        vec4 w3 = q5_1_weight(qw3, hw3, lane, sm3);
        FG_PAIR(0, a0, live0)
        FG_PAIR(1, a1, live1)
        FG_PAIR(2, a2, live2)
        FG_PAIR(3, a3, live3)
    }

    FG_REDUCE(acc00) FG_REDUCE(acc01) FG_REDUCE(acc02) FG_REDUCE(acc03)
    FG_REDUCE(acc10) FG_REDUCE(acc11) FG_REDUCE(acc12) FG_REDUCE(acc13)
    FG_REDUCE(acc20) FG_REDUCE(acc21) FG_REDUCE(acc22) FG_REDUCE(acc23)
    FG_REDUCE(acc30) FG_REDUCE(acc31) FG_REDUCE(acc32) FG_REDUCE(acc33)

    if (lane == 0u) {
        store_pair(p0, row0, acc00, acc10, acc20, acc30);
        store_pair(p1, row0, acc01, acc11, acc21, acc31);
        store_pair(p2, row0, acc02, acc12, acc22, acc32);
        store_pair(p3, row0, acc03, acc13, acc23, acc33);
    }
}
