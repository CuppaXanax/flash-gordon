#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Normed{float normed[];};layout(set=0,binding=1)readonly buffer UpLogits{float up[];};layout(set=0,binding=2)readonly buffer InjectLogits{float inject_logits[];};layout(set=0,binding=3)writeonly buffer Mixed{float mixed[];};layout(set=0,binding=4)writeonly buffer Injection{float injection[];};
layout(push_constant)uniform Push{uint hidden;uint groups;uint n_tok;}pc;float sigmoid(float v){return 1.0/(1.0+exp(-v));}
void main(){uint tid=gl_LocalInvocationID.x,t=gl_WorkGroupID.x;if(t>=pc.n_tok)return;for(uint i=tid;i<pc.hidden;i+=256u){float value=0.0;for(uint g=0u;g<pc.groups;g++){uint j=(t*pc.groups+g)*pc.hidden+i;value=fma(sigmoid(up[j]),normed[j],value);}mixed[t*pc.hidden+i]=value/float(pc.groups);}if(tid<pc.groups)injection[t*pc.groups+tid]=2.0*sigmoid(inject_logits[t*pc.groups+tid]/float(pc.groups));}
