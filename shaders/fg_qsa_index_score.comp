layout(push_constant)uniform Push{uint tokens;uint blocks;}pc;
shared float key_value[128];shared float reduce_value[128];shared float head_sum[4];
uint load_byte(uint byte_offset){uint word=keys[byte_offset>>2u];return(word>>((byte_offset&3u)*8u))&255u;}
float load_q8(uint token,uint element){uint block=element>>5u,inside=element&31u,base=token*136u+block*34u;uint half_bits=load_byte(base)|(load_byte(base+1u)<<8u);float d=unpackHalf2x16(half_bits).x;int q=int(load_byte(base+2u+inside));if(q>=128)q-=256;return d*float(q);}
void main(){uint lane=gl_LocalInvocationID.x,block=gl_WorkGroupID.x;if(block>=pc.blocks)return;uint first=block*4u;float pooled=0.0;for(uint t=0u;t<4u;t++)pooled+=load_q8(first+t,lane)*0.25;key_value[lane]=pooled;reduce_value[lane]=pooled*pooled;barrier();for(uint stride=64u;stride>0u;stride>>=1u){if(lane<stride)reduce_value[lane]+=reduce_value[lane+stride];barrier();}float value=pooled*inversesqrt(reduce_value[0]/128.0+1e-6)*norm_weight[lane];key_value[lane]=value;barrier();if(lane<32u){uint axis=(lane%3u==1u)?1u:((lane%3u==2u&&lane<30u)?2u:0u);float angle=float(positions[first*3u+axis])/pow(10000000.0,float(2u*lane)/64.0),c=cos(angle),s=sin(angle),a=key_value[lane],b=key_value[lane+32u];key_value[lane]=a*c-b*s;key_value[lane+32u]=b*c+a*s;}barrier();for(uint head=0u;head<4u;head++){reduce_value[lane]=query[head*128u+lane]*key_value[lane];barrier();for(uint stride=64u;stride>0u;stride>>=1u){if(lane<stride)reduce_value[lane]+=reduce_value[lane+stride];barrier();}if(lane==0u)head_sum[head]=max(reduce_value[0],0.0);barrier();}if(lane==0u){scores[block]=(head_sum[0]+head_sum[1]+head_sum[2]+head_sum[3])*0.08838834764831845;ids[block]=block;}}
