#version 460
layout(local_size_x=128,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Query{float query[];};
layout(set=0,binding=1)readonly buffer Keys{uint keys[];};
layout(set=0,binding=2)readonly buffer Norm{float norm_weight[];};
layout(set=0,binding=3)readonly buffer Positions{uint positions[];};
layout(set=0,binding=4)writeonly buffer Scores{float scores[];};
