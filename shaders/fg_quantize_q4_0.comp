#version 460
layout(local_size_x=32,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Input{float x[];};layout(set=0,binding=1)buffer Output{uint output_words[];};layout(push_constant)uniform Push{uint width;uint blocks;uint tokens;}pc;shared float maximum_abs[32];shared float maximum_value[32];
void store_byte(uint offset,uint value){atomicOr(output_words[offset>>2u],(value&255u)<<((offset&3u)*8u));}
void main(){uint lane=gl_LocalInvocationID.x,token=gl_WorkGroupID.x;if(token>=pc.tokens)return;uint row_bytes=pc.blocks*18u,row_word=token*(row_bytes>>2u);for(uint i=lane;i<row_bytes/4u;i+=32u)output_words[row_word+i]=0u;barrier();for(uint block=0u;block<pc.blocks;block++){float value=x[token*pc.width+block*32u+lane];maximum_abs[lane]=abs(value);maximum_value[lane]=value;barrier();for(uint stride=16u;stride>0u;stride>>=1u){if(lane<stride&&maximum_abs[lane]<maximum_abs[lane+stride]){maximum_abs[lane]=maximum_abs[lane+stride];maximum_value[lane]=maximum_value[lane+stride];}barrier();}float d=maximum_value[0]/-8.0,inv=d!=0.0?1.0/d:0.0;uint base=token*row_bytes+block*18u;if(lane==0u){uint bits=packHalf2x16(vec2(d,0.0));store_byte(base,bits);store_byte(base+1u,bits>>8u);}if(lane<16u){int lo=min(15,int(x[token*pc.width+block*32u+lane]*inv+8.5));int hi=min(15,int(x[token*pc.width+block*32u+lane+16u]*inv+8.5));store_byte(base+2u+lane,uint(lo|(hi<<4)));}barrier();}}
