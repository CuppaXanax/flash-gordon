layout(local_size_x=128,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Raw{float raw_query[];};layout(set=0,binding=1)readonly buffer Norm{float norm_weight[];};layout(set=0,binding=2)readonly buffer Position{uint position[];};layout(set=0,binding=3)writeonly buffer Output{float query[];};shared float values[128];shared float squares[128];
