void main(){uint lane=gl_LocalInvocationID.x,token=gl_WorkGroupID.x;if(token>=pc.tokens)return;uint row_bytes=pc.blocks*34u,row_word=token*(row_bytes>>2u);for(uint i=lane;i<row_bytes/4u;i+=32u)output_words[row_word+i]=0u;barrier();for(uint block=0u;block<pc.blocks;block++){float value=x[token*pc.width+block*32u+lane];maximum[lane]=abs(value);barrier();for(uint stride=16u;stride>0u;stride>>=1u){if(lane<stride)maximum[lane]=max(maximum[lane],maximum[lane+stride]);barrier();}float d=maximum[0]/127.0,inv=d!=0.0?1.0/d:0.0;uint base=token*row_bytes+block*34u;if(lane==0u){uint bits=packHalf2x16(vec2(d,0.0));store_byte(base,bits);store_byte(base+1u,bits>>8u);}int q=int(clamp(round_away(value*inv),-127.0,127.0));store_byte(base+2u+lane,uint(q));barrier();}}
