layout(local_size_x=32,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Input{float x[];};layout(set=0,binding=1)buffer Output{uint output_words[];};layout(push_constant)uniform Push{uint width;uint blocks;uint tokens;}pc;shared float maximum[32];
