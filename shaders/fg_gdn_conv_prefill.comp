#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Projection{float projection[];};
layout(set=0,binding=1)readonly buffer Weight{float weight[];};
layout(set=0,binding=2)buffer State{float state[];};
layout(set=0,binding=3)writeonly buffer Output{float output_value[];};
layout(push_constant)uniform Push{uint channels;uint tokens;}pc;
void main(){
    uint channel=gl_GlobalInvocationID.x;if(channel>=pc.channels)return;uint base=channel*4u;
    float s0=state[base],s1=state[base+1u],s2=state[base+2u],s3=state[base+3u];
    for(uint token=0u;token<pc.tokens;token++){
        float current=projection[token*pc.channels+channel];
        float value=weight[base]*s1+weight[base+1u]*s2+weight[base+2u]*s3+weight[base+3u]*current;
        s0=s1;s1=s2;s2=s3;s3=current;output_value[token*pc.channels+channel]=value/(1.0+exp(-value));
    }
    state[base]=s0;state[base+1u]=s1;state[base+2u]=s2;state[base+3u]=s3;
}
