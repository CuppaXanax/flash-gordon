#version 460
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require

layout(local_size_x=128,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};
layout(set=0,binding=0)readonly buffer WeightsPair{uvec2 wb2[];};
layout(set=0,binding=0)readonly buffer WeightsVector{uvec4 wb4[];};
layout(set=0,binding=1)readonly buffer Input{vec4 x4[];};
layout(set=0,binding=2)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint n_tok;uint blocks;uint tile_bytes;float scale;}pc;
shared vec4 subgroup_sum[128];

void main(){
    uint local_id=gl_LocalInvocationID.x;
    uint row_half=local_id>>6u,lane=local_id&63u,block_in_group=lane>>2u,word_pair=lane&3u;
    uint wg_first_row=gl_WorkGroupID.x*8u,first_row=wg_first_row+row_half*4u,token=gl_WorkGroupID.y;
    if(first_row>=pc.out_dim||token>=pc.n_tok)return;
    uint tile_base=(first_row>>4u)*pc.tile_bytes,wg_tile_row=wg_first_row&15u;
    uint quant_offset=(16u*pc.blocks*2u+63u)&~63u;
    uvec4 row_offsets=(uvec4(wg_tile_row,wg_tile_row+1u,wg_tile_row+2u,wg_tile_row+3u)+row_half*4u)*pc.blocks*32u;
    uvec4 quant_base=tile_base+quant_offset+row_offsets;
    uint input_base=token*pc.blocks*8u,groups=(pc.blocks+15u)/16u;
    vec4 accumulator=vec4(0.0);
    for(uint group=0u;group<groups;group++){
        uint block=group*16u+block_in_group;bool live=block<pc.blocks;
        uint safe_block=live?block:(pc.blocks-1u);
        uint scale_word=(tile_base>>2u)+safe_block*8u+(wg_tile_row>>1u);
        uvec4 scales=wb4[scale_word>>2u];
        vec4 delta=vec4(0.0);
        if(live)delta=row_half==0u?vec4(unpackHalf2x16(scales.x),unpackHalf2x16(scales.y)):vec4(unpackHalf2x16(scales.z),unpackHalf2x16(scales.w));
        uint pair_base=safe_block*4u+word_pair;
        uvec2 packed0=wb2[(quant_base.x>>3u)+pair_base];
        uvec2 packed1=wb2[(quant_base.y>>3u)+pair_base];
        uvec2 packed2=wb2[(quant_base.z>>3u)+pair_base];
        uvec2 packed3=wb2[(quant_base.w>>3u)+pair_base];
        uint input_index=input_base+safe_block*8u+word_pair*2u;
        vec4 input_lo=live?x4[input_index]:vec4(0.0);
        vec4 input_hi=live?x4[input_index+1u]:vec4(0.0);
        vec4 products=vec4(dot(vec4(unpack8(int32_t(packed0.x))),input_lo)+dot(vec4(unpack8(int32_t(packed0.y))),input_hi),
                           dot(vec4(unpack8(int32_t(packed1.x))),input_lo)+dot(vec4(unpack8(int32_t(packed1.y))),input_hi),
                           dot(vec4(unpack8(int32_t(packed2.x))),input_lo)+dot(vec4(unpack8(int32_t(packed2.y))),input_hi),
                           dot(vec4(unpack8(int32_t(packed3.x))),input_lo)+dot(vec4(unpack8(int32_t(packed3.y))),input_hi));
        accumulator=fma(delta,products,accumulator);
    }
    if(gl_SubgroupSize>64u){
        subgroup_sum[local_id]=accumulator;
        barrier();
        if(local_id==0u){vec4 total=vec4(0.0);for(uint lane_index=0u;lane_index<64u;lane_index++)total+=subgroup_sum[lane_index];for(uint row=0u;row<4u;row++)if(wg_first_row+row<pc.out_dim)y[token*pc.out_dim+wg_first_row+row]=total[row]*pc.scale;}
        if(local_id==64u){vec4 total=vec4(0.0);for(uint lane_index=64u;lane_index<128u;lane_index++)total+=subgroup_sum[lane_index];for(uint row=0u;row<4u;row++)if(wg_first_row+4u+row<pc.out_dim)y[token*pc.out_dim+wg_first_row+4u+row]=total[row]*pc.scale;}
        return;
    }
    vec4 reduced=vec4(subgroupAdd(accumulator.x),subgroupAdd(accumulator.y),subgroupAdd(accumulator.z),subgroupAdd(accumulator.w));
    if(subgroupElect())subgroup_sum[gl_SubgroupID]=reduced;
    barrier();
    if(local_id==0u){
        vec4 total0=vec4(0.0),total1=vec4(0.0);
        for(uint subgroup=0u;subgroup<gl_NumSubgroups;subgroup++){
            vec4 value=subgroup_sum[subgroup];
            if(((subgroup*gl_SubgroupSize)>>6u)==0u)total0+=value;else total1+=value;
        }
        for(uint row=0u;row<4u;row++){
            if(wg_first_row+row<pc.out_dim)y[token*pc.out_dim+wg_first_row+row]=total0[row]*pc.scale;
            if(wg_first_row+4u+row<pc.out_dim)y[token*pc.out_dim+wg_first_row+4u+row]=total1[row]*pc.scale;
        }
    }
}
