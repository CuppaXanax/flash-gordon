#version 460
layout(local_size_x=256) in;
layout(set=0,binding=0) readonly buffer Experts {float experts[];};
layout(set=0,binding=1) readonly buffer Gates {float gates[];};
layout(set=0,binding=2) writeonly buffer Output {float values[];};
layout(push_constant) uniform Push {uint width;uint tokens;} pc;
void main(){
    uint i=gl_GlobalInvocationID.x,t=gl_GlobalInvocationID.y;
    if(i>=pc.width||t>=pc.tokens)return;
    float sum=0.0;
    for(uint slot=0;slot<10u;slot++){
        uint pair=t*10u+slot;
        // Missing slots are never read: their expert storage is uninitialized.
        if(gates[pair]!=0.0)sum=fma(gates[pair],experts[pair*pc.width+i],sum);
    }
    values[t*pc.width+i]=sum;
}
