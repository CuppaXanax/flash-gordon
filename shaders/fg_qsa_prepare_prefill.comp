#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer RawQueryGate{float raw_qg[];};layout(set=0,binding=1)readonly buffer RawKey{float raw_k[];};layout(set=0,binding=2)readonly buffer QueryNorm{float qnorm[];};layout(set=0,binding=3)readonly buffer KeyNorm{float knorm[];};layout(set=0,binding=4)readonly buffer Position{uint position[];};layout(set=0,binding=5)writeonly buffer Query{float query[];};layout(set=0,binding=6)writeonly buffer Gate{float gate[];};layout(set=0,binding=7)writeonly buffer Key{float key[];};layout(push_constant)uniform Push{uint tokens;}pc;shared float values[256];shared float squares[256];
void normalize_rope(uint lane,float weight,uint token){float value=values[lane];squares[lane]=value*value;barrier();for(uint stride=128u;stride>0u;stride>>=1u){if(lane<stride)squares[lane]+=squares[lane+stride];barrier();}values[lane]=value*inversesqrt(squares[0]/256.0+1e-6)*weight;barrier();if(lane<32u){uint axis=(lane%3u==1u)?1u:((lane%3u==2u&&lane<30u)?2u:0u);float angle=float(position[token*3u+axis])/pow(10000000.0,float(2u*lane)/64.0),c=cos(angle),s=sin(angle),a=values[lane],b=values[lane+32u];values[lane]=a*c-b*s;values[lane+32u]=b*c+a*s;}barrier();}
void main(){uint lane=gl_LocalInvocationID.x,work=gl_WorkGroupID.x,token=work/24u,head=work%24u;if(token>=pc.tokens)return;uint qg_base=token*12288u,query_base=token*6144u,key_base=token*512u;values[lane]=raw_qg[qg_base+head*512u+lane];gate[query_base+head*256u+lane]=raw_qg[qg_base+head*512u+256u+lane];normalize_rope(lane,qnorm[lane],token);query[query_base+head*256u+lane]=values[lane];barrier();if(head<2u){values[lane]=raw_k[key_base+head*256u+lane];normalize_rope(lane,knorm[lane],token);key[key_base+head*256u+lane]=values[lane];}}
