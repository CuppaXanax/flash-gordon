#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};layout(set=0,binding=1)readonly buffer Activation{uint q8[];};layout(set=0,binding=2)readonly buffer Tiles{uint tiles[];};layout(set=0,binding=3)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint blocks;uint row_bytes;uint expert_stride;uint type;uint n_used;uint routed_pairs;uint packed_weights;uint reserved;}pc;
const uint Q4_K=12u,Q5_K=13u,PAIR_TILE=8u,TILE_WORDS=9u,INVALID_PAIR=0xffffffffu,Q8K_WORDS=74u;shared float lane_sum[512];shared uint shared_q8[592];
uint load_u8(uint off){return(wb[off>>2u]>>((off&3u)*8u))&255u;}uint load_u16(uint off){return load_u8(off)|(load_u8(off+1u)<<8u);}float load_f16(uint off){return unpackHalf2x16(load_u16(off)).x;}
int q8_value(uint slot,uint index){uint value=(shared_q8[slot*Q8K_WORDS+2u+(index>>2u)]>>((index&3u)*8u))&255u;return value>=128u?int(value)-256:int(value);}float q8_delta(uint slot){return uintBitsToFloat(shared_q8[slot*Q8K_WORDS]);}int q8_sum(uint slot,uint index){uint word=shared_q8[slot*Q8K_WORDS+66u+(index>>1u)],value=(index&1u)==0u?word&65535u:word>>16u;return value>=32768u?int(value)-65536:int(value);}
void scale_min(uint base,uint group,out uint scale,out uint minimum){uint s0=load_u8(base+4u+group);if(group<4u){scale=s0&63u;minimum=load_u8(base+8u+group)&63u;}else{uint upper=load_u8(base+8u+group),lower=load_u8(base+group);scale=(upper&15u)|((lower>>6u)<<4u);minimum=(upper>>4u)|((s0>>6u)<<4u);}}
uint q4_value(uint base,uint index){uint group=index>>5u,i=index&31u,packed=load_u8(base+16u+(group>>1u)*32u+i);return(group&1u)==0u?packed&15u:packed>>4u;}uint q5_value(uint base,uint index){uint group=index>>5u,i=index&31u,packed=load_u8(base+48u+(group>>1u)*32u+i),low=(group&1u)==0u?packed&15u:packed>>4u,high=(load_u8(base+16u+i)>>group)&1u;return low|(high<<4u);}
void main(){uint lane=gl_LocalInvocationID.x,row=gl_WorkGroupID.x,tile=gl_WorkGroupID.y,tile_base=tile*TILE_WORDS,expert=tiles[tile_base];if(expert==INVALID_PAIR||row>=pc.out_dim)return;uint weight_index=pc.packed_weights!=0u?tile:expert,row_base=weight_index*pc.expert_stride+row*pc.row_bytes,block_bytes=pc.row_bytes/pc.blocks,group=lane>>3u,index_in_group=(lane&7u)*4u;uint pair[PAIR_TILE];float acc[PAIR_TILE];for(uint slot=0u;slot<PAIR_TILE;slot++){pair[slot]=tiles[tile_base+1u+slot];acc[slot]=0.0;}
for(uint block=0u;block<pc.blocks;block++){for(uint slot=0u;slot<PAIR_TILE;slot++){uint p=pair[slot],qbase=(p!=INVALID_PAIR?p/pc.n_used:0u)*pc.blocks*Q8K_WORDS+block*Q8K_WORDS;for(uint word=lane;word<Q8K_WORDS;word+=64u)shared_q8[slot*Q8K_WORDS+word]=p!=INVALID_PAIR?q8[qbase+word]:0u;}barrier();uint base=row_base+block*block_bytes,index=group*32u+index_in_group,scale,minimum;scale_min(base,group,scale,minimum);float wd=load_f16(base),wdmin=load_f16(base+2u);for(uint slot=0u;slot<PAIR_TILE;slot++){if(pair[slot]==INVALID_PAIR)continue;int integer_dot=int(scale)*(int(pc.type==Q4_K?q4_value(base,index):q5_value(base,index))*q8_value(slot,index)+int(pc.type==Q4_K?q4_value(base,index+1u):q5_value(base,index+1u))*q8_value(slot,index+1u)+int(pc.type==Q4_K?q4_value(base,index+2u):q5_value(base,index+2u))*q8_value(slot,index+2u)+int(pc.type==Q4_K?q4_value(base,index+3u):q5_value(base,index+3u))*q8_value(slot,index+3u));float contribution=wd*q8_delta(slot)*float(integer_dot);if(index_in_group==0u)contribution=fma(-wdmin*q8_delta(slot)*float(minimum),float(q8_sum(slot,group*2u)+q8_sum(slot,group*2u+1u)),contribution);acc[slot]+=contribution;}barrier();}
for(uint slot=0u;slot<PAIR_TILE;slot++)lane_sum[slot*64u+lane]=acc[slot];barrier();for(uint stride=32u;stride>0u;stride>>=1u){if(lane<stride)for(uint slot=0u;slot<PAIR_TILE;slot++)lane_sum[slot*64u+lane]+=lane_sum[slot*64u+lane+stride];barrier();}if(lane==0u)for(uint slot=0u;slot<PAIR_TILE;slot++){uint p=pair[slot];if(p!=INVALID_PAIR&&p<pc.routed_pairs)y[p*pc.out_dim+row]=lane_sum[slot*64u];}}
