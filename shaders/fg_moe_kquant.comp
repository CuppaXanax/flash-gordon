#version 460
layout(local_size_x=64,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)readonly buffer Weights{uint wb[];};layout(set=0,binding=1)readonly buffer Activation{uint q8[];};layout(set=0,binding=2)readonly buffer Tiles{uint tiles[];};layout(set=0,binding=3)writeonly buffer Output{float y[];};
layout(push_constant)uniform Push{uint out_dim;uint blocks;uint row_bytes;uint expert_stride;uint type;uint n_used;uint routed_pairs;uint packed_weights;uint reserved;}pc;
const uint Q4_K=12u,Q5_K=13u,PAIR_TILE=8u,TILE_WORDS=9u,INVALID_PAIR=0xffffffffu,Q8K_WORDS=74u;shared float lane_sum[512];shared float min_sum[512];shared uint shared_q8[592];
uint load_u8(uint off){return(wb[off>>2u]>>((off&3u)*8u))&255u;}uint load_u16(uint off){return load_u8(off)|(load_u8(off+1u)<<8u);}float load_f16(uint off){return unpackHalf2x16(load_u16(off)).x;}
int q8_value(uint slot,uint index){uint value=(shared_q8[slot*Q8K_WORDS+2u+(index>>2u)]>>((index&3u)*8u))&255u;return value>=128u?int(value)-256:int(value);}float q8_delta(uint slot){return uintBitsToFloat(shared_q8[slot*Q8K_WORDS]);}int q8_sum(uint slot,uint index){uint word=shared_q8[slot*Q8K_WORDS+66u+(index>>1u)],value=(index&1u)==0u?word&65535u:word>>16u;return value>=32768u?int(value)-65536:int(value);}
void scale_min(uint base,uint group,out uint scale,out uint minimum){uint s0=load_u8(base+4u+group);if(group<4u){scale=s0&63u;minimum=load_u8(base+8u+group)&63u;}else{uint upper=load_u8(base+8u+group),lower=load_u8(base+group);scale=(upper&15u)|((lower>>6u)<<4u);minimum=(upper>>4u)|((s0>>6u)<<4u);}}
uint q4_value(uint base,uint index){uint group=index>>5u,i=index&31u,packed=load_u8(base+16u+(group>>1u)*32u+i);return(group&1u)==0u?packed&15u:packed>>4u;}uint q5_value(uint base,uint index){uint group=index>>5u,i=index&31u,packed=load_u8(base+48u+(group>>1u)*32u+i),low=(group&1u)==0u?packed&15u:packed>>4u,high=(load_u8(base+16u+i)>>group)&1u;return low|(high<<4u);}
void main(){uint lid=gl_LocalInvocationID.x,row=gl_WorkGroupID.x*8u+(lid>>3u),lane=lid&7u,tile=gl_WorkGroupID.y,tile_base=tile*TILE_WORDS,expert=tiles[tile_base];if(expert==INVALID_PAIR)return;bool row_live=row<pc.out_dim;uint weight_index=pc.packed_weights!=0u?tile:expert,row_base=weight_index*pc.expert_stride+(row_live?row:0u)*pc.row_bytes,block_bytes=pc.row_bytes/pc.blocks;uint pair[PAIR_TILE];float acc[PAIR_TILE],minimum_acc[PAIR_TILE];for(uint slot=0u;slot<PAIR_TILE;slot++){pair[slot]=tiles[tile_base+1u+slot];acc[slot]=0.0;minimum_acc[slot]=0.0;}
for(uint block=0u;block<pc.blocks;block++){for(uint slot=0u;slot<PAIR_TILE;slot++){uint p=pair[slot],qbase=(p!=INVALID_PAIR?p/pc.n_used:0u)*pc.blocks*Q8K_WORDS+block*Q8K_WORDS;for(uint word=lid;word<Q8K_WORDS;word+=64u)shared_q8[slot*Q8K_WORDS+word]=p!=INVALID_PAIR?q8[qbase+word]:0u;}barrier();if(row_live){uint base=row_base+block*block_bytes;float wd=load_f16(base),wdmin=load_f16(base+2u);uint scales[8],minimums[8];for(uint group=0u;group<8u;group++)scale_min(base,group,scales[group],minimums[group]);for(uint slot=0u;slot<PAIR_TILE;slot++){if(pair[slot]==INVALID_PAIR)continue;int integer_dot=0;for(uint group=0u;group<8u;group++){uint index=group*32u+lane*4u;
/* Load 4 Q4/Q5 nibbles from one uint32 word instead of 4 load_u8 calls */
uint gi=index&31u,ghalf=group>>1u;
uint poff=base+(pc.type==Q4_K?16u:48u)+ghalf*32u+gi;
uint pw=poff>>2u,ps=(poff&3u)*8u;
uint packed4=ps==0u?wb[pw]:(wb[pw]>>ps)|(wb[pw+1u]<<(32u-ps));
uint nq0,nq1,nq2,nq3;
if((group&1u)==0u){nq0=packed4&0xFu;nq1=(packed4>>8u)&0xFu;nq2=(packed4>>16u)&0xFu;nq3=(packed4>>24u)&0xFu;}
else{nq0=(packed4>>4u)&0xFu;nq1=(packed4>>12u)&0xFu;nq2=(packed4>>20u)&0xFu;nq3=(packed4>>28u)&0xFu;}
/* Q5_K adds a high bit per quant from a separate array */
if(pc.type==Q5_K){uint hoff=base+16u+gi;uint hw=wb[hoff>>2u];uint hs=(hoff&3u)*8u;uint hbits=(hw>>hs);
nq0|=((hbits>>group)&1u)<<4u;nq1|=(((wb[(hoff+1u)>>2u]>>(((hoff+1u)&3u)*8u))>>group)&1u)<<4u;
nq2|=(((wb[(hoff+2u)>>2u]>>(((hoff+2u)&3u)*8u))>>group)&1u)<<4u;nq3|=(((wb[(hoff+3u)>>2u]>>(((hoff+3u)&3u)*8u))>>group)&1u)<<4u;}
/* Load 4 Q8_K values from one shared memory word (index is 4-aligned) */
uint q8w=shared_q8[slot*Q8K_WORDS+2u+(index>>2u)];
int a0=int(q8w&0xFFu);a0-=(a0>=128)?256:0;int a1=int((q8w>>8u)&0xFFu);a1-=(a1>=128)?256:0;
int a2=int((q8w>>16u)&0xFFu);a2-=(a2>=128)?256:0;int a3=int(q8w>>24u);a3-=(a3>=128)?256:0;
integer_dot+=int(scales[group])*(int(nq0)*a0+int(nq1)*a1+int(nq2)*a2+int(nq3)*a3);}acc[slot]=fma(wd*q8_delta(slot),float(integer_dot),acc[slot]);if((pc.type==Q5_K&&lane==0u)||(pc.type==Q4_K&&lane<4u)){int min_dot=0;uint begin=pc.type==Q5_K?0u:lane*2u,end=pc.type==Q5_K?8u:begin+2u;for(uint group=begin;group<end;group++)min_dot+=int(minimums[group])*(q8_sum(slot,group*2u)+q8_sum(slot,group*2u+1u));minimum_acc[slot]=fma(-wdmin*q8_delta(slot),float(min_dot),minimum_acc[slot]);}}}barrier();}
for(uint slot=0u;slot<PAIR_TILE;slot++){lane_sum[slot*64u+lid]=acc[slot];min_sum[slot*64u+lid]=minimum_acc[slot];}barrier();if(row_live&&lane==0u){for(uint slot=0u;slot<PAIR_TILE;slot++){uint p=pair[slot],offset=slot*64u+lid;if(p==INVALID_PAIR||p>=pc.routed_pairs)continue;float result=((lane_sum[offset]+lane_sum[offset+4u])+(lane_sum[offset+2u]+lane_sum[offset+6u]))+((lane_sum[offset+1u]+lane_sum[offset+5u])+(lane_sum[offset+3u]+lane_sum[offset+7u]));result+=pc.type==Q5_K?min_sum[offset]:(min_sum[offset]+min_sum[offset+1u]+min_sum[offset+2u]+min_sum[offset+3u]);y[p*pc.out_dim+row]=result;}}}
