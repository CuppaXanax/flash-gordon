#version 460

layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;

layout(set = 0, binding = 0) readonly buffer Selected { uint selected[]; };
layout(set = 0, binding = 1) writeonly buffer Tiles { uint tiles[]; };

layout(push_constant) uniform Push { uint tokens; } pc;

const uint TOP_K = 10u;
const uint TILE_WORDS = 9u;
const uint INVALID = 0xffffffffu;

/* Token-tagged decode tile schedule.  Word 0 is the expert, word 1 the global
   (token, routing slot) pair id, word 2 the token.  A single-token client
   passes tokens=1 and gets the historical layout word-for-word (the token word
   used to be INVALID and every consumer treats it as token 0); the batch-2
   expert union writes 2*TOP_K tiles into one schedule so one gate/up and one
   down/reduce dispatch serves both tokens.  Order stays token-major so each
   token's accumulation sequence is its own routed order. */
void main() {
    uint index = gl_LocalInvocationID.x;
    if (index >= pc.tokens * TOP_K) return;
    uint token = index / TOP_K;
    uint base = index * TILE_WORDS;
    for (uint word = 0u; word < TILE_WORDS; word++) tiles[base + word] = INVALID;
    tiles[base] = selected[index];
    tiles[base + 1u] = index;
    tiles[base + 2u] = token;
}
