#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;
layout(set=0,binding=0)buffer Values{float value[];};
layout(push_constant)uniform Push{uint count;}pc;
void main(){
    uint index=gl_GlobalInvocationID.x;
    if(index>=pc.count)return;
    float x=value[index];
    value[index]=0.5*x*(1.0+tanh(0.7978845608*(x+0.044715*x*x*x)));
}
