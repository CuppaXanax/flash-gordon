#version 460
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_EXT_control_flow_attributes : require
layout(local_size_x=128) in;
layout(set=0,binding=0) readonly buffer Weights{uint wb[];};
layout(set=0,binding=1) readonly buffer Tiles{uint tiles[];};
layout(set=0,binding=2) readonly buffer Input{vec4 x4[];};
layout(set=0,binding=3) writeonly buffer Parts{float parts[];};
layout(push_constant) uniform Push{
    uint rows,in_dim,blocks,tile_bytes,expert_stride;
}pc;
void main(){
    uint lid=gl_LocalInvocationID.x,lane=lid&7u,part=(lid>>3u)&3u;
    uint row=gl_WorkGroupID.x*4u+(lid>>5u),base=gl_WorkGroupID.y*5u;
    uint expert=tiles[base];
    if(expert==0xffffffffu||row>=pc.rows)return;
    uvec4 pairs=uvec4(tiles[base+1u],tiles[base+2u],tiles[base+3u],tiles[base+4u]);
    uint quant_offset=(pc.blocks*32u+63u)&~63u;
    uint row_base=expert*pc.expert_stride+(row>>4u)*pc.tile_bytes;
    uint scale_word=((row_base+(row&15u)*2u)>>2u)+part*8u;
    uint quant_word=(row_base+quant_offset+(row&15u)*pc.blocks*32u)/4u+lane+part*8u;
    vec4 acc=vec4(0.0);
    for(uint block=part;block<pc.blocks;block+=4u){
        vec2 scales=unpackHalf2x16(wb[scale_word]);
        float delta=(row&1u)!=0u?scales.y:scales.x;
        vec4 weight=vec4(unpack8(int(wb[quant_word])));
        [[unroll]]for(uint p=0u;p<4u;p++){
            if(pairs[p]!=0xffffffffu){
                uint at=pairs[p]*(pc.in_dim>>2u)+block*8u+lane;
                acc[p]=fma(delta,dot(weight,x4[at]),acc[p]);
            }
        }
        scale_word+=32u;quant_word+=32u;
    }
    // Keep four K partitions per pair; the existing reducer applies token gates.
    acc+=subgroupShuffleXor(acc,4u);
    acc+=subgroupShuffleXor(acc,2u);
    acc+=subgroupShuffleXor(acc,1u);
    if(lane==0u){
        [[unroll]]for(uint p=0u;p<4u;p++)if(pairs[p]!=0xffffffffu)
            parts[(pairs[p]*pc.rows+row)*4u+part]=acc[p];
    }
}
