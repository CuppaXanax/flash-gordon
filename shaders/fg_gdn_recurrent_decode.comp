#version 460
layout(local_size_x=128,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer QKV{float qkv[];};layout(set=0,binding=1)readonly buffer ZGate{float z[];};layout(set=0,binding=2)readonly buffer Alpha{float alpha[];};layout(set=0,binding=3)readonly buffer Beta{float beta[];};layout(set=0,binding=4)readonly buffer ADecay{float a_decay[];};layout(set=0,binding=5)readonly buffer DtBias{float dt_bias[];};layout(set=0,binding=6)readonly buffer NormWeight{float norm_weight[];};layout(set=0,binding=7)buffer RecurrentState{float recurrent[];};layout(set=0,binding=8)writeonly buffer Output{float output_value[];};layout(push_constant)uniform Push{uint value_heads;uint key_heads;uint head_dim;float epsilon;}pc;
shared float query[128],key[128],delta[128],attention[128],sum_q[128],sum_k[128],sum_out[128];
float softplus(float value){return max(value,0.0)+log(1.0+exp(-abs(value)));}
void main(){uint lane=gl_LocalInvocationID.x,head=gl_WorkGroupID.x;if(head>=pc.value_heads||lane>=pc.head_dim)return;uint key_head=head/(pc.value_heads/pc.key_heads),key_width=pc.key_heads*pc.head_dim,value_base=2u*key_width;
query[lane]=qkv[key_head*pc.head_dim+lane];key[lane]=qkv[key_width+key_head*pc.head_dim+lane];float value=qkv[value_base+head*pc.head_dim+lane];sum_q[lane]=query[lane]*query[lane];sum_k[lane]=key[lane]*key[lane];barrier();for(uint stride=64u;stride>0u;stride>>=1u){if(lane<stride){sum_q[lane]+=sum_q[lane+stride];sum_k[lane]+=sum_k[lane+stride];}barrier();}float qscale=inversesqrt(sum_q[0]+pc.epsilon)/sqrt(float(pc.head_dim)),kscale=inversesqrt(sum_k[0]+pc.epsilon);query[lane]*=qscale;key[lane]*=kscale;barrier();
float decay=exp(a_decay[head]*softplus(alpha[head]+dt_bias[head])),mix=1.0/(1.0+exp(-beta[head]));uint state_base=head*pc.head_dim*pc.head_dim;float memory=0.0;for(uint k=0u;k<pc.head_dim;k++)memory=fma(recurrent[state_base+k*pc.head_dim+lane]*decay,key[k],memory);delta[lane]=(value-memory)*mix;barrier();for(uint v=0u;v<pc.head_dim;v++){uint index=state_base+lane*pc.head_dim+v;recurrent[index]=recurrent[index]*decay+key[lane]*delta[v];}barrier();float result=0.0;for(uint k=0u;k<pc.head_dim;k++)result=fma(recurrent[state_base+k*pc.head_dim+lane],query[k],result);attention[lane]=result;sum_out[lane]=result*result;barrier();for(uint stride=64u;stride>0u;stride>>=1u){if(lane<stride)sum_out[lane]+=sum_out[lane+stride];barrier();}float normalized=attention[lane]*inversesqrt(sum_out[0]/float(pc.head_dim)+pc.epsilon)*norm_weight[lane],gate=z[head*pc.head_dim+lane];output_value[head*pc.head_dim+lane]=normalized*(gate/(1.0+exp(-gate)));}
