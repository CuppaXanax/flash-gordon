#version 460
layout(local_size_x=256,local_size_y=1,local_size_z=1)in;layout(set=0,binding=0)readonly buffer Records{uint records[];};layout(set=0,binding=1)readonly buffer Query{float query[];};layout(set=0,binding=2)readonly buffer Gate{float gate[];};layout(set=0,binding=3)writeonly buffer Output{float output_value[];};layout(push_constant)uniform Push{uint selected_count;}pc;shared float reduction[256];shared float old_scale;shared float new_weight;shared float denominator;shared float maximum;
uint load_byte(uint byte_offset){return(records[byte_offset>>2u]>>((byte_offset&3u)*8u))&255u;}
float load_half(uint byte_offset){uint bits=load_byte(byte_offset)|(load_byte(byte_offset+1u)<<8u);return unpackHalf2x16(bits).x;}
float load_key(uint token,uint kv_head,uint element){uint base=token*980u+kv_head*272u+(element>>5u)*34u;int q=int(load_byte(base+2u+(element&31u)));if(q>=128)q-=256;return load_half(base)*float(q);}
float load_value(uint token,uint kv_head,uint element){uint base=token*980u+544u+kv_head*144u+(element>>5u)*18u,inside=element&31u,packed=load_byte(base+2u+(inside&15u));int q=int(inside<16u?(packed&15u):(packed>>4u))-8;return load_half(base)*float(q);}
void main(){uint lane=gl_LocalInvocationID.x,head=gl_WorkGroupID.x;if(head>=24u||pc.selected_count==0u)return;uint kv_head=head/12u;float accumulator=0.0;if(lane==0u){maximum=-3.402823466e38;denominator=0.0;}barrier();for(uint token=0u;token<pc.selected_count;token++){reduction[lane]=query[head*256u+lane]*load_key(token,kv_head,lane);barrier();for(uint stride=128u;stride>0u;stride>>=1u){if(lane<stride)reduction[lane]+=reduction[lane+stride];barrier();}if(lane==0u){float score=reduction[0]*0.0625,new_max=max(maximum,score);old_scale=maximum<-3.0e38?0.0:exp(maximum-new_max);new_weight=exp(score-new_max);denominator=denominator*old_scale+new_weight;maximum=new_max;}barrier();accumulator=accumulator*old_scale+load_value(token,kv_head,lane)*new_weight;barrier();}float sigmoid_gate=1.0/(1.0+exp(-gate[head*256u+lane]));output_value[head*256u+lane]=accumulator/denominator*sigmoid_gate;}
